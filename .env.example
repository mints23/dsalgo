# Supabase — use Cloudflare proxy in production (India ISP blocks *.supabase.co)
# See docs/CLOUDFLARE_SUPABASE_PROXY.md
PUBLIC_SUPABASE_URL=https://api.algofrog.in
# Direct URL (only if reachable from your network / for scripts):
# PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional production OAuth origin override (defaults to current browser origin)
# PUBLIC_AUTH_REDIRECT_ORIGIN=https://algofrog.in

# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:4321/auth/callback
#   http://localhost:4321/**
#   https://algofrog.in/auth/callback
#   https://algofrog.in/**
# For scripts/sync-solutions-from-db.ts and seed-problem-playback.ts (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx-here

# Discord → Server Settings → Invites → copy link (shows Join Discord on site when set)
PUBLIC_DISCORD_INVITE_URL=https://discord.gg/gSccpmtm

# Razorpay webhook + confirm Edge Functions (secrets in Supabase Dashboard — NOT in static site)
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxx
# RAZORPAY_KEY_ID=rzp_live_xxx          # same as PUBLIC_RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET=xxxxxxxx          # Dashboard → API Keys → Key secret
