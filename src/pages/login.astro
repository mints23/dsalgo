---
/**
 * Login page only. Preview drawer uses `login-sneak-static` — not imported by `index.astro` or the app shell.
 */
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';
import DiscordJoin from '../components/DiscordJoin.astro';
import { GUIDE_PROBLEM_ROW_COUNT } from '../data/site-stats';
import {
  LOGIN_SNEAK_NAV,
  LOGIN_SNEAK_SAMPLE_TOPIC,
  LOGIN_SNEAK_SAMPLE_ROWS,
  type LoginSneakNavRow,
} from '../data/login-sneak-static';

const sectionOrder = [
  'Algorithms',
  'Data Structures',
  'Dynamic Programming',
  'Graphs',
  'Advanced Techniques',
];

const sidebarTopicCount = LOGIN_SNEAK_NAV.length;

const grouped = new Map<string, LoginSneakNavRow[]>();
for (const t of LOGIN_SNEAK_NAV) {
  const arr = grouped.get(t.navSection) ?? [];
  arr.push(t);
  grouped.set(t.navSection, arr);
}

const sections = sectionOrder.filter((s) => grouped.has(s)).concat(
  [...grouped.keys()].filter((s) => !sectionOrder.includes(s)),
);

type SneakItem =
  | { kind: 'section'; label: string; stagger: number }
  | { kind: 'topic'; topic: LoginSneakNavRow; stagger: number };

const sneakItems: SneakItem[] = [];
let rawStagger = 0;
for (const section of sections) {
  sneakItems.push({
    kind: 'section',
    label: section,
    stagger: Math.min(rawStagger++, 24),
  });
  for (const t of grouped.get(section)!) {
    sneakItems.push({
      kind: 'topic',
      topic: t,
      stagger: Math.min(rawStagger++, 24),
    });
  }
}

const tableStaggerBase = 26;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — DSA Mastery Guide · algofrog.in</title>
    <meta
      name="description"
      content="DSA sheet with problems in teaching order, not a shuffled list. Preview the full roadmap without an account; sign in to sync progress. Email, Google, or GitHub."
    />
    <meta name="theme-color" content="#1f5c61" />
    <link rel="canonical" href="https://algofrog.in/login" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* Login route only — scoped to this HTML file; does not ship on `/` */
      .login-page {
        --login-gold: #b8952e;
        --login-gold-soft: color-mix(in oklab, #b8952e 22%, var(--border));
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        padding:
          max(0.75rem, env(safe-area-inset-top, 0px))
          clamp(1rem, 3vw, 2rem)
          clamp(1.5rem, 4vh, 2.5rem);
        position: relative;
        background:
          radial-gradient(ellipse 90% 70% at 0% 0%, color-mix(in oklab, #b8952e 7%, transparent), transparent 52%),
          radial-gradient(ellipse 80% 60% at 100% 0%, color-mix(in oklab, var(--primary) 14%, transparent), transparent 48%),
          radial-gradient(ellipse 70% 50% at 50% 100%, color-mix(in oklab, var(--primary) 8%, transparent), transparent 55%),
          var(--bg);
      }
      [data-theme='dark'] .login-page {
        --login-gold: #d4b44a;
        background:
          radial-gradient(ellipse 80% 60% at 0% 0%, color-mix(in oklab, #d4b44a 8%, transparent), transparent 50%),
          radial-gradient(ellipse 70% 50% at 100% 0%, color-mix(in oklab, var(--primary) 16%, transparent), transparent 45%),
          var(--bg);
      }
      .login-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        max-width: min(1120px, 100%);
        margin: 0 auto 1.25rem;
        padding-bottom: 0.85rem;
        border-bottom: 1px solid color-mix(in oklab, var(--login-gold-soft) 55%, var(--divider));
      }
      .login-header-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--text);
        font-size: 0.82rem;
        font-weight: 650;
        letter-spacing: -0.02em;
      }
      .login-header-brand:hover {
        color: var(--primary);
      }
      .login-header-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }
      .login-shell {
        width: 100%;
        max-width: min(1120px, 100%);
        margin-inline: auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: clamp(1.75rem, 4vw, 2.5rem);
        align-items: center;
        flex: 1;
      }
      @media (min-width: 960px) {
        .login-shell {
          grid-template-columns: minmax(0, 1.08fr) minmax(340px, 400px);
          gap: clamp(2.5rem, 6vw, 4.5rem);
          min-height: min(560px, calc(100dvh - 8rem));
        }
      }
      .login-hero {
        order: 2;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        padding: 0;
        width: 100%;
        min-width: 0;
        text-align: center;
      }
      @media (min-width: 960px) {
        .login-hero {
          order: 0;
          text-align: left;
          max-width: 34rem;
        }
      }
      .login-hero-mark {
        display: block;
        margin: 0 auto;
        border-radius: 14px;
        box-shadow:
          0 8px 32px color-mix(in srgb, var(--primary) 18%, transparent),
          0 0 0 1px color-mix(in oklab, var(--login-gold) 25%, transparent);
      }
      @media (min-width: 960px) {
        .login-hero-mark {
          margin: 0;
        }
      }
      .login-hero-eyebrow {
        margin: 0.15rem 0 0;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: color-mix(in oklab, var(--login-gold) 75%, var(--muted));
      }
      .login-hero-title {
        margin: 0;
        font-family: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
        font-size: clamp(2rem, 5.5vw, 2.85rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        line-height: 1.12;
        color: var(--text);
      }
      .login-hero-title em {
        font-style: italic;
        font-weight: 500;
        color: color-mix(in oklab, var(--primary) 88%, var(--text));
      }
      .login-hero-lead {
        margin: 0;
        font-size: clamp(0.92rem, 2vw, 1rem);
        line-height: 1.55;
        color: var(--muted);
        max-width: 28rem;
      }
      @media (min-width: 960px) {
        .login-hero-lead {
          margin-top: 0.15rem;
        }
      }
      .login-hero-stats {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.85rem;
        margin: 0.25rem auto 0;
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        border: 1px solid var(--login-gold-soft);
        background: color-mix(in oklab, var(--login-gold) 5%, var(--surface));
      }
      @media (min-width: 960px) {
        .login-hero-stats {
          margin: 0.25rem 0 0;
          justify-content: flex-start;
        }
      }
      .login-hero-stat {
        font-size: 0.78rem;
        color: var(--muted);
      }
      .login-hero-stat strong {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--text);
        margin-right: 0.2rem;
      }
      .login-hero-stat-div {
        width: 1px;
        height: 1rem;
        background: var(--login-gold-soft);
      }
      .login-hero-peek {
        align-self: center;
        margin-top: 0.35rem;
        padding: 0;
        border: none;
        background: none;
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: color-mix(in oklab, var(--primary) 35%, transparent);
        transition: color 0.15s, text-decoration-color 0.15s;
      }
      @media (min-width: 960px) {
        .login-hero-peek {
          align-self: flex-start;
        }
      }
      .login-hero-peek:hover {
        color: var(--primary-h);
        text-decoration-color: var(--primary);
      }
      .login-hero-peek:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 3px;
        border-radius: 2px;
      }
      .login-main {
        order: 1;
        width: 100%;
        min-width: 0;
        align-self: stretch;
      }
      @media (min-width: 960px) {
        .login-main {
          order: 1;
        }
      }
      .login-card-kicker {
        display: none;
      }
      .login-card-title {
        margin: 0 0 0.35rem;
        font-family: 'Cormorant Garamond', Georgia, serif;
        font-size: clamp(1.55rem, 3.5vw, 1.75rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text);
        line-height: 1.15;
      }
      .login-card-lede {
        margin: 0 0 1.35rem;
        font-size: 0.82rem;
        line-height: 1.45;
        color: var(--muted);
      }

      .login-peek-backdrop {
        position: fixed;
        inset: 0;
        z-index: 70;
        background: color-mix(in srgb, var(--text) 22%, transparent);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease;
      }
      .login-peek-backdrop.is-open {
        opacity: 1;
        pointer-events: auto;
      }

      .login-peek-drawer {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        z-index: 80;
        /* Half the viewport on wider screens; nearly full width on narrow phones */
        width: min(92vw, 100%);
        max-width: 100%;
        background: var(--bg);
        border-right: 1px solid var(--border);
        box-shadow: 8px 0 40px color-mix(in srgb, var(--text) 12%, transparent);
        transform: translateX(-105%);
        transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
        display: flex;
        flex-direction: column;
        min-height: 0;
      }
      @media (min-width: 640px) {
        .login-peek-drawer {
          width: 50vw;
        }
      }
      .login-peek-drawer.is-open {
        transform: translateX(0);
      }
      @media (prefers-reduced-motion: reduce) {
        .login-peek-drawer {
          transition-duration: 0.15s;
        }
      }
      .login-peek-drawer-top {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.65rem 0.75rem 0.65rem 1rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
      }
      .login-peek-drawer-title {
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text);
      }
      .login-peek-drawer-close {
        flex-shrink: 0;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 0.4rem;
        background: var(--offset);
        color: var(--muted);
        font-size: 1.2rem;
        line-height: 1;
        cursor: pointer;
        transition: background 0.12s, color 0.12s;
      }
      .login-peek-drawer-close:hover {
        background: var(--divider);
        color: var(--text);
      }
      .login-peek-drawer-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 0.85rem 1.15rem 1.5rem;
        -webkit-overflow-scrolling: touch;
      }
      .login-peek-drawer-body .login-sneak {
        border: none;
        box-shadow: none;
        background: transparent;
        padding: 0.35rem 0 0;
        max-width: 52rem;
        margin: 0 auto;
      }
      .login-peek-drawer-body .login-sneak::before {
        display: none;
      }
      .login-card {
        width: 100%;
        max-width: none;
        position: relative;
        overflow: hidden;
        background: color-mix(in oklab, var(--surface) 96%, var(--bg));
        border: 1px solid color-mix(in oklab, var(--login-gold) 22%, var(--border));
        border-radius: 1rem;
        box-shadow:
          0 28px 64px -36px color-mix(in oklab, var(--primary) 28%, transparent),
          0 0 0 1px color-mix(in srgb, #fff 35%, transparent);
        padding: clamp(1.65rem, 3.5vw, 2rem) clamp(1.45rem, 3vw, 1.85rem);
      }
      .login-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(
          90deg,
          transparent,
          color-mix(in oklab, var(--login-gold) 80%, var(--primary)),
          transparent
        );
      }
      [data-theme='dark'] .login-card {
        box-shadow:
          0 24px 56px -28px rgba(0, 0, 0, 0.55),
          0 0 0 1px color-mix(in oklab, var(--login-gold) 12%, transparent);
      }
      .login-trust-peek-btn {
        display: inline;
        padding: 0;
        margin: 0;
        border: none;
        background: none;
        font: inherit;
        font-weight: 700;
        color: var(--primary);
        cursor: pointer;
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      .login-trust-peek-btn:hover {
        color: var(--primary-h);
      }
      .login-card-footer {
        margin-top: 1.25rem;
        padding-top: 0.85rem;
        border-top: 1px solid color-mix(in oklab, var(--login-gold-soft) 45%, var(--divider));
        font-size: 0.68rem;
        color: var(--faint);
        text-align: center;
        line-height: 1.5;
      }
      .login-card-footer a {
        color: var(--muted);
        font-weight: 500;
        text-decoration: none;
      }
      .login-card-footer a:hover {
        color: var(--primary);
        text-decoration: underline;
      }
      .login-oauth-stack {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        margin-bottom: 0.15rem;
      }
      .login-oauth-stack .oauth-btn {
        margin-bottom: 0;
      }
      .login-oauth-stack .oauth-btn--primary {
        background: var(--primary);
        color: #f8fbfb;
        border-color: color-mix(in oklab, var(--primary) 85%, #000);
        font-weight: 650;
        padding: 0.72rem 0.85rem;
        box-shadow: 0 4px 18px -6px color-mix(in oklab, var(--primary) 45%, transparent);
      }
      .login-oauth-stack .oauth-btn--primary:hover {
        background: var(--primary-h);
        border-color: var(--primary-h);
      }
      [data-theme='dark'] .login-oauth-stack .oauth-btn--primary {
        color: #f4f8f8;
      }
      .login-tabs {
        display: flex;
        border-bottom: 1px solid color-mix(in oklab, var(--login-gold-soft) 40%, var(--divider));
        margin-bottom: 1.15rem;
        gap: 0.25rem;
      }
      .login-tab {
        flex: 1;
        padding: 0.55rem 0;
        text-align: center;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        transition: color 0.15s, border-color 0.15s;
        background: none;
        border-top: none;
        border-left: none;
        border-right: none;
      }
      .login-tab.active {
        color: var(--primary);
        border-bottom-color: var(--primary);
      }
      .login-tab:hover {
        color: var(--text);
      }
      .form-group {
        margin-bottom: 1rem;
      }
      .form-group label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--muted);
        margin-bottom: 0.35rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .form-group input {
        width: 100%;
        padding: 0.6rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--bg);
        color: var(--text);
        font-family: inherit;
        font-size: 0.85rem;
        outline: none;
        transition: border-color 0.15s;
      }
      .form-group input:focus {
        border-color: var(--primary);
      }
      .login-btn {
        width: 100%;
        padding: 0.68rem;
        border-radius: 0.45rem;
        background: var(--primary);
        color: var(--inv);
        font-weight: 650;
        font-size: 0.85rem;
        border: none;
        cursor: pointer;
        transition: background 0.15s, box-shadow 0.15s;
        margin-top: 0.35rem;
        box-shadow: 0 4px 16px -6px color-mix(in oklab, var(--primary) 40%, transparent);
      }
      .login-btn:hover {
        background: var(--primary-h);
      }
      .login-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .divider-row {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        margin: 1.25rem 0;
        color: var(--faint);
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .divider-row--oauth {
        margin: 0.35rem 0 0.55rem;
      }
      .divider-row--email {
        margin: 1.1rem 0 1rem;
      }
      .login-oauth-first .oauth-btn:last-of-type {
        margin-bottom: 0;
      }
      .divider-row::before,
      .divider-row::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--divider);
      }
      .oauth-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.6rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface2);
        color: var(--text);
        font-size: 0.82rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
        margin-bottom: 0.6rem;
      }
      .oauth-btn:hover {
        background: var(--offset);
        border-color: var(--primary);
      }
      .oauth-btn svg {
        flex-shrink: 0;
      }
      .login-msg {
        font-size: 0.78rem;
        padding: 0.55rem 0.75rem;
        border-radius: 0.4rem;
        margin-bottom: 1rem;
        display: none;
      }
      .login-msg.error {
        display: block;
        background: color-mix(in oklab, var(--error) 12%, var(--bg));
        color: var(--error);
        border: 1px solid color-mix(in oklab, var(--error) 25%, var(--border));
      }
      .login-msg.success {
        display: block;
        background: color-mix(in oklab, var(--primary) 12%, var(--bg));
        color: var(--primary);
        border: 1px solid color-mix(in oklab, var(--primary) 25%, var(--border));
      }
      .login-top-bar-left,
      .login-top-bar-right,
      .login-top-help {
        display: none;
      }
      .theme-toggle-login {
        position: static;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-height: 2.25rem;
        min-width: 2.25rem;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface);
        color: var(--muted);
        transition:
          color 0.15s,
          background 0.12s,
          border-color 0.12s;
        flex-shrink: 0;
      }
      .theme-toggle-login:hover {
        color: var(--text);
        background: color-mix(in srgb, var(--primary) 6%, var(--surface));
        border-color: color-mix(in srgb, var(--primary) 22%, var(--border));
      }
      [data-theme='dark'] .theme-toggle-login {
        background: color-mix(in srgb, var(--surface) 92%, var(--bg));
        border-color: color-mix(in srgb, var(--border) 80%, transparent);
      }

      .login-sneak {
        position: relative;
        background: color-mix(in srgb, var(--surface) 72%, var(--bg));
        border: 1px solid color-mix(in srgb, var(--border) 65%, transparent);
        border-radius: 1rem;
        padding: 1.35rem 1.35rem 1.2rem;
        min-width: 0;
        box-shadow: 0 1px 0 color-mix(in srgb, var(--primary) 12%, transparent);
      }
      .login-sneak::before {
        content: '';
        position: absolute;
        left: 1rem;
        right: 1rem;
        top: 0;
        height: 3px;
        border-radius: 0 0 3px 3px;
        background: linear-gradient(
          90deg,
          color-mix(in srgb, var(--primary) 45%, transparent),
          color-mix(in srgb, var(--primary) 15%, transparent)
        );
        opacity: 0.85;
      }
      .login-sneak-kicker {
        display: inline-block;
        font-size: 0.6rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 9%, var(--bg));
        border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--border));
        padding: 0.2rem 0.5rem;
        border-radius: 999px;
        margin-bottom: 0.55rem;
      }
      .login-sneak-title {
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        margin-bottom: 0.4rem;
        line-height: 1.2;
        color: var(--text);
      }
      .login-sneak-sub {
        font-size: 0.78rem;
        color: var(--muted);
        line-height: 1.5;
        margin-bottom: 1rem;
        font-weight: 400;
      }
      .login-sneak-sub strong {
        color: var(--text);
        font-weight: 600;
      }

      /* Full topic grid height — no inner scrollbox; the drawer body scrolls so most/all topics show in one pass */
      .login-sneak-scroll {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.15rem 0.6rem;
        padding: 0.45rem 0.35rem 0.45rem 0;
        margin-bottom: 1.1rem;
      }
      @media (max-width: 520px) {
        .login-sneak-scroll {
          grid-template-columns: 1fr;
        }
      }

      .login-sneak-sec {
        grid-column: 1 / -1;
        font-size: 0.58rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: var(--muted);
        padding: 0.5rem 0.25rem 0.15rem;
        margin-top: 0.1rem;
        border-bottom: 1px solid color-mix(in srgb, var(--divider) 55%, transparent);
      }
      .login-sneak-sec:first-child {
        padding-top: 0;
        margin-top: 0;
      }

      .login-sneak-topic {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.32rem 0.4rem;
        border-radius: 0.45rem;
        font-size: 0.7rem;
        color: var(--text);
        transition: background 0.12s ease;
      }
      .login-sneak-topic:hover {
        background: color-mix(in srgb, var(--primary) 6%, var(--surface));
      }
      .login-sneak-topic-num {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.62rem;
        font-weight: 600;
        color: color-mix(in srgb, var(--muted) 85%, var(--primary));
        min-width: 1.25rem;
      }
      .login-sneak-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        margin-left: auto;
        flex-shrink: 0;
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--border) 80%, transparent);
      }

      @keyframes login-sneak-rise {
        from {
          opacity: 0;
          transform: translateY(5px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .login-sneak-anim {
        opacity: 0;
        animation: login-sneak-rise 0.38s cubic-bezier(0.25, 0.9, 0.35, 1) forwards;
        animation-delay: calc(var(--s, 0) * 18ms);
      }
      @media (prefers-reduced-motion: reduce) {
        .login-sneak-anim {
          animation: none;
          opacity: 1;
          transform: none;
        }
      }

      .login-sneak-sample-h {
        font-size: 0.58rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 0.35rem;
      }
      .login-sneak-sample-title {
        font-size: 0.95rem;
        font-weight: 700;
        margin-bottom: 0.2rem;
        letter-spacing: -0.02em;
        color: var(--text);
      }
      .login-sneak-sample-meta {
        font-size: 0.72rem;
        color: var(--muted);
        margin-bottom: 0.7rem;
        line-height: 1.4;
      }
      .login-sneak-tbl-wrap {
        overflow-x: auto;
        border-radius: 0.55rem;
        border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
        background: color-mix(in srgb, var(--surface) 55%, var(--bg));
      }
      .login-sneak table {
        font-size: 0.65rem;
        margin: 0;
      }
      .login-peek-drawer-body .login-sneak table {
        font-size: 0.7rem;
      }
      .login-peek-drawer-body .login-sneak table th,
      .login-peek-drawer-body .login-sneak table td {
        padding: 0.45rem 0.55rem;
      }
      .login-sneak table th,
      .login-sneak table td {
        padding: 0.38rem 0.42rem;
        border-bottom: 1px solid color-mix(in srgb, var(--divider) 70%, transparent);
      }
      .login-sneak table thead th {
        font-size: 0.57rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
        background: transparent;
      }
      .login-sneak table tbody tr:hover {
        background: color-mix(in srgb, var(--primary) 5%, transparent);
      }
      .login-sneak table tbody tr:last-child td {
        border-bottom: none;
      }
      .login-sneak-foot {
        font-size: 0.68rem;
        color: var(--muted);
        margin-top: 0.75rem;
        line-height: 1.45;
        padding-top: 0.65rem;
        border-top: 1px dashed color-mix(in srgb, var(--divider) 85%, transparent);
      }
    </style>
  </head>
  <body>
    <div class="login-page" id="login-page-root">
      <header class="login-header">
        <a href="/" class="login-header-brand">
          <LogoMark width={28} height={28} alt="" />
          <span>algofrog.in</span>
        </a>
        <div class="login-header-actions">
          <DiscordJoin variant="topbar" />
          <button class="theme-toggle-login" id="theme-toggle-login" aria-label="Toggle theme">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
          </button>
        </div>
      </header>

      <div class="login-peek-backdrop" id="login-peek-backdrop" aria-hidden="true"></div>

      <div
        class="login-peek-drawer"
        id="login-peek-drawer"
        role="dialog"
        aria-modal="true"
        aria-labelledby="login-peek-heading"
        aria-hidden="true"
      >
        <div class="login-peek-drawer-top">
          <span class="login-peek-drawer-title" id="login-peek-heading">Preview — same roadmap as the app</span>
          <button type="button" class="login-peek-drawer-close" id="login-peek-close" aria-label="Close preview">
            ×
          </button>
        </div>
        <div class="login-peek-drawer-body">
          <aside class="login-sneak" aria-label="Static curriculum preview">
            <p class="login-sneak-kicker">No account—just the same order you’ll see after sign-in</p>
            <h2 class="login-sneak-title">Scroll the list, then decide</h2>
            <p class="login-sneak-sub">
              Topics match the live guide. The table is a short slice of
              <strong>{LOGIN_SNEAK_SAMPLE_TOPIC.title}</strong>
              ({LOGIN_SNEAK_SAMPLE_TOPIC.summaryMeta.split('·')[0]?.trim()}).
            </p>

            <div class="login-sneak-scroll">
              {
                sneakItems.map((item) =>
                  item.kind === 'section' ? (
                    <div class="login-sneak-sec login-sneak-anim" style={`--s:${item.stagger}`}>
                      {item.label}
                    </div>
                  ) : (
                    <div class="login-sneak-topic login-sneak-anim" style={`--s:${item.stagger}`}>
                      <span class="login-sneak-topic-num">{item.topic.displayNumber}</span>
                      <span>{item.topic.navLabel}</span>
                      <span class="login-sneak-dot" style={`background:${item.topic.navTierDotColor}`} />
                    </div>
                  ),
                )
              }
            </div>

            <p class="login-sneak-sample-h">Sample problem rows</p>
            <h3 class="login-sneak-sample-title">{LOGIN_SNEAK_SAMPLE_TOPIC.title}</h3>
            <p class="login-sneak-sample-meta">{LOGIN_SNEAK_SAMPLE_TOPIC.summaryMeta}</p>
            <div class="login-sneak-tbl-wrap">
              <table>
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Layer</th>
                    <th>Link</th>
                    <th>Problem</th>
                    <th>Diff</th>
                    <th>Key insight</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    LOGIN_SNEAK_SAMPLE_ROWS.map((p, i) => (
                      <tr class="login-sneak-anim" style={`--s:${tableStaggerBase + i}`}>
                        <td class="num-cell">{p.num}</td>
                        <td>
                          <span class={p.layerCls}>{p.layer}</span>
                        </td>
                        <td>
                          <a class="lc-link" href={p.href} target="_blank" rel="noopener noreferrer">
                            LC {p.lc}
                          </a>
                        </td>
                        <td class="prob-name">{p.name}</td>
                        <td>
                          <span class={p.diffCls}>{p.diff}</span>
                        </td>
                        <td class="insight">{p.insight}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
            <p class="login-sneak-foot">
              Sign in when you want full tables, saved checkboxes, study modes, and Pro replays.
            </p>
          </aside>
        </div>
      </div>

      <div class="login-shell">
        <aside class="login-hero" aria-label="About algofrog.in">
          <LogoMark width={56} height={56} class="login-hero-mark" />
          <p class="login-hero-eyebrow">DSA Mastery Guide</p>
          <h1 class="login-hero-title">
            Every problem in order.<br />
            <em>Built to master, not shuffle.</em>
          </h1>
          <p class="login-hero-lead">
            Open the full sheet — progress syncs, filters stick, and each topic builds on the last.
          </p>
          <div class="login-hero-stats">
            <span class="login-hero-stat"><strong>{sidebarTopicCount}</strong> topics</span>
            <span class="login-hero-stat-div" aria-hidden="true"></span>
            <span class="login-hero-stat"><strong>{GUIDE_PROBLEM_ROW_COUNT}</strong> problems</span>
          </div>
          <button
            type="button"
            class="login-hero-peek"
            id="login-hero-peek-btn"
            aria-expanded="false"
            aria-controls="login-peek-drawer"
          >
            Preview the roadmap — no account needed
          </button>
        </aside>

        <main class="login-main" id="main-content">
          <div class="login-card">
        <h2 class="login-card-title">Open your sheet</h2>
        <p class="login-card-lede">Google or GitHub — one tap and you’re in.</p>

        <div class="login-oauth-stack">
            <button type="button" class="oauth-btn oauth-btn--primary" id="google-btn" aria-label="Continue with Google">
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18A11.96 11.96 0 0 0 1 12c0 1.93.46 3.77 1.18 5.43l3.66-2.84z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
              Continue with Google
            </button>

            <button type="button" class="oauth-btn" id="github-btn" aria-label="Continue with GitHub">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
              Continue with GitHub
            </button>
        </div>

        <div class="divider-row divider-row--email">Or email</div>

        <div class="login-tabs" role="tablist" aria-label="Account access">
          <button
            type="button"
            class="login-tab active"
            id="tab-signin"
            role="tab"
            aria-selected="true"
            aria-controls="signin-panel"
            tabindex="0"
          >
            Sign in
          </button>
          <button
            type="button"
            class="login-tab"
            id="tab-signup"
            role="tab"
            aria-selected="false"
            aria-controls="signup-panel"
            tabindex="-1"
          >
            Sign up
          </button>
        </div>

        <div id="login-msg" class="login-msg"></div>

        <!-- Sign In Form -->
        <div id="signin-panel" role="tabpanel" aria-labelledby="tab-signin">
        <form id="signin-form" autocomplete="on">
          <div class="form-group">
            <label for="signin-email">Email</label>
            <input type="email" id="signin-email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </div>
          <div class="form-group">
            <label for="signin-password">Password</label>
            <input type="password" id="signin-password" name="password" required autocomplete="current-password" placeholder="Your password" />
          </div>
          <button type="submit" class="login-btn" id="signin-btn">Sign in</button>
        </form>
        </div>

        <!-- Sign Up Form -->
        <div id="signup-panel" role="tabpanel" aria-labelledby="tab-signup" hidden>
        <form id="signup-form" autocomplete="on">
          <div class="form-group">
            <label for="signup-name">Full Name</label>
            <input type="text" id="signup-name" name="name" required autocomplete="name" placeholder="Your name" />
          </div>
          <div class="form-group">
            <label for="signup-email">Email</label>
            <input type="email" id="signup-email" name="email" required autocomplete="email" placeholder="you@example.com" />
          </div>
          <div class="form-group">
            <label for="signup-password">Password</label>
            <input type="password" id="signup-password" name="password" required autocomplete="new-password" placeholder="Min 6 characters" minlength="6" />
          </div>
          <button type="submit" class="login-btn" id="signup-btn">Create account</button>
        </form>
        </div>

        <p class="login-card-footer">
          Free 7-day trial · <a href="/connect">Mentoring</a> · © 2026 algofrog.in
        </p>

          </div>
        </main>
      </div>
    </div>

    <script>
      import { supabase } from '../lib/supabase';
      import {
        getAuthCallbackUrl,
        getLoginOAuthReturnUrl,
        goToAppPath,
        resolveLoginRedirectPath,
        storeAuthRedirect,
      } from '../lib/auth-redirect';

      const redirectPath = resolveLoginRedirectPath();
      const msgEl = document.getElementById('login-msg')!;

      function showMsg(text: string, type: 'error' | 'success') {
        msgEl.textContent = text;
        msgEl.className = `login-msg ${type}`;
      }
      function clearMsg() {
        msgEl.className = 'login-msg';
        msgEl.textContent = '';
      }

      async function finishAuthEntry() {
        const params = new URLSearchParams(window.location.search);
        const oauthErr = params.get('error') || params.get('error_description');
        if (oauthErr) {
          showMsg(decodeURIComponent(oauthErr.replace(/\+/g, ' ')), 'error');
          const clean =
            redirectPath !== '/'
              ? `${window.location.origin}/login?redirect=${encodeURIComponent(redirectPath)}`
              : `${window.location.origin}/login`;
          window.history.replaceState({}, '', clean);
          return;
        }

        const {
          data: { user },
          error: userErr,
        } = await supabase.auth.getUser();
        if (user && !userErr) {
          goToAppPath(redirectPath);
        } else if (userErr) {
          await supabase.auth.signOut();
        }
      }

      void finishAuthEntry();

      /** Clears preview-only UI so it never leaves `body` locked or overlays active after navigation. */
      function resetLoginPreviewChrome() {
        try {
          document.body.style.overflow = '';
          document.getElementById('login-page-root')?.classList.remove('peek-open');
          document.getElementById('login-peek-drawer')?.classList.remove('is-open');
          document.getElementById('login-peek-backdrop')?.classList.remove('is-open');
          const openBtn = document.getElementById('login-hero-peek-btn');
          const drawer = document.getElementById('login-peek-drawer');
          const backdrop = document.getElementById('login-peek-backdrop');
          openBtn?.setAttribute('aria-expanded', 'false');
          drawer?.setAttribute('aria-hidden', 'true');
          backdrop?.setAttribute('aria-hidden', 'true');
        } catch {
          document.body.style.overflow = '';
        }
      }

      /** Optional preview: failures here must not block sign-in / OAuth. */
      function initLoginPreviewOptional() {
        const loginPageRoot = document.getElementById('login-page-root');
        const peekDrawer = document.getElementById('login-peek-drawer');
        const peekBackdrop = document.getElementById('login-peek-backdrop');
        const peekOpen = document.getElementById('login-hero-peek-btn');
        const peekClose = document.getElementById('login-peek-close');
        if (!loginPageRoot || !peekDrawer || !peekBackdrop || !peekOpen || !peekClose) return;

        function openPeek() {
          try {
            peekDrawer.classList.add('is-open');
            peekBackdrop.classList.add('is-open');
            loginPageRoot.classList.add('peek-open');
            document.body.style.overflow = 'hidden';
            peekOpen.setAttribute('aria-expanded', 'true');
            peekDrawer.setAttribute('aria-hidden', 'false');
            peekBackdrop.setAttribute('aria-hidden', 'false');
            peekClose.focus();
          } catch {
            resetLoginPreviewChrome();
          }
        }

        function closePeek() {
          try {
            peekDrawer.classList.remove('is-open');
            peekBackdrop.classList.remove('is-open');
            loginPageRoot.classList.remove('peek-open');
            document.body.style.overflow = '';
            peekOpen.setAttribute('aria-expanded', 'false');
            peekDrawer.setAttribute('aria-hidden', 'true');
            peekBackdrop.setAttribute('aria-hidden', 'true');
            peekOpen.focus();
          } catch {
            resetLoginPreviewChrome();
          }
        }

        peekOpen.addEventListener('click', () => openPeek());
        peekBackdrop.addEventListener('click', () => closePeek());
        peekClose.addEventListener('click', () => closePeek());
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && peekDrawer.classList.contains('is-open')) {
            e.preventDefault();
            closePeek();
          }
        });
        window.addEventListener('pagehide', resetLoginPreviewChrome);
      }

      initLoginPreviewOptional();

      // Tab switching
      const tabSignin = document.getElementById('tab-signin')!;
      const tabSignup = document.getElementById('tab-signup')!;
      const signinPanel = document.getElementById('signin-panel')!;
      const signupPanel = document.getElementById('signup-panel')!;
      const signinForm = document.getElementById('signin-form') as HTMLFormElement;
      const signupForm = document.getElementById('signup-form') as HTMLFormElement;

      tabSignin.addEventListener('click', () => {
        tabSignin.classList.add('active');
        tabSignup.classList.remove('active');
        tabSignin.setAttribute('aria-selected', 'true');
        tabSignup.setAttribute('aria-selected', 'false');
        tabSignin.tabIndex = 0;
        tabSignup.tabIndex = -1;
        signinPanel.hidden = false;
        signupPanel.hidden = true;
        clearMsg();
      });
      tabSignup.addEventListener('click', () => {
        tabSignup.classList.add('active');
        tabSignin.classList.remove('active');
        tabSignup.setAttribute('aria-selected', 'true');
        tabSignin.setAttribute('aria-selected', 'false');
        tabSignup.tabIndex = 0;
        tabSignin.tabIndex = -1;
        signinPanel.hidden = true;
        signupPanel.hidden = false;
        clearMsg();
      });

      // Sign In
      signinForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMsg();
        const btn = document.getElementById('signin-btn') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Signing in…';

        const email = (document.getElementById('signin-email') as HTMLInputElement).value;
        const password = (document.getElementById('signin-password') as HTMLInputElement).value;

        const { data, error } = await supabase.auth.signInWithPassword({ email, password });

        if (error) {
          showMsg(error.message, 'error');
          btn.disabled = false;
          btn.textContent = 'Sign in';
        } else if (!data.session) {
          showMsg('Sign-in failed to create a session. Try again or clear site data for this origin.', 'error');
          btn.disabled = false;
          btn.textContent = 'Sign in';
        } else {
          resetLoginPreviewChrome();
          goToAppPath(redirectPath);
        }
      });

      // Sign Up
      signupForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMsg();
        const btn = document.getElementById('signup-btn') as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = 'Creating account…';

        const email = (document.getElementById('signup-email') as HTMLInputElement).value;
        const password = (document.getElementById('signup-password') as HTMLInputElement).value;

        const name = (document.getElementById('signup-name') as HTMLInputElement).value.trim();

        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            data: { full_name: name },
            emailRedirectTo: getLoginOAuthReturnUrl(redirectPath),
          },
        });

        if (error) {
          showMsg(error.message, 'error');
        } else if (data.user && data.user.identities && data.user.identities.length === 0) {
          showMsg('An account with this email already exists. Please sign in instead.', 'error');
        } else {
          showMsg('Check your email for a confirmation link!', 'success');
        }
        btn.disabled = false;
        btn.textContent = 'Create account';
      });

      // Google OAuth
      document.getElementById('google-btn')!.addEventListener('click', async () => {
        storeAuthRedirect(redirectPath);
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: {
            redirectTo: getAuthCallbackUrl(),
            queryParams: { prompt: 'select_account' },
          },
        });
        if (error) showMsg(error.message, 'error');
      });


      // GitHub OAuth
      document.getElementById('github-btn')!.addEventListener('click', async () => {
        storeAuthRedirect(redirectPath);
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'github',
          options: { redirectTo: getAuthCallbackUrl() },
        });
        if (error) showMsg(error.message, 'error');
      });

      // Theme toggle
      document.getElementById('theme-toggle-login')!.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
