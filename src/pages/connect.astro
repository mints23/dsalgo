---
import '../styles/global.css';
import '../styles/connect-client.css';
import LogoMark from '../components/LogoMark.astro';
import DiscordJoin from '../components/DiscordJoin.astro';
import {
  SESSION_FOOTNOTE,
  connectServices as services,
  connectOfferings,
  isConnectSlotBookable,
  connectBatchCopy,
} from '../data/connect-services';

const sessionFootnote = SESSION_FOOTNOTE;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connect — 1:1 Mentoring · algofrog.in</title>
    <meta
      name="description"
      content="Personal mentoring for high-CTC prep — system design, roadmaps, CV review, DSA classes, and 1:1 mentorship. From the team behind DSA Mastery."
    />
    <meta name="theme-color" content="#1f5c61" />
    <link rel="canonical" href="https://algofrog.in/connect" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style>
      .connect-page {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        padding: clamp(0.75rem, 2.5vw, 1.5rem) clamp(1rem, 3vw, 2rem) clamp(1.5rem, 3vh, 2rem);
        position: relative;
        overflow-x: hidden;
        background:
          radial-gradient(ellipse 90% 70% at 0% 0%, color-mix(in oklab, var(--royal-gold) 7%, transparent), transparent 52%),
          radial-gradient(ellipse 80% 60% at 100% 0%, color-mix(in oklab, var(--primary) 14%, transparent), transparent 48%),
          var(--bg);
      }
      .connect-shell {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 52rem;
        margin: 0 auto;
      }
      .connect-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.75rem;
      }
      .connect-brand .logo-mark {
        border-radius: 8px;
        box-shadow: 0 4px 18px color-mix(in srgb, var(--primary) 14%, transparent);
      }
      .connect-brand-text {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: 1.02rem;
        line-height: 1.2;
        letter-spacing: -0.02em;
      }
      .connect-brand-sub {
        display: none;
      }
      .connect-intro {
        margin: 0 auto 1.5rem;
        max-width: 28rem;
        text-align: center;
      }
      .connect-intro-title {
        margin: 0;
        font-family: var(--font-display);
        font-size: clamp(1.85rem, 5vw, 2.45rem);
        font-weight: 600;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text);
      }
      .connect-intro-title em {
        font-style: italic;
        font-weight: 500;
        color: color-mix(in oklab, var(--royal-gold) 80%, var(--primary));
      }
      .connect-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--text);
      }
      .connect-top-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }
      .connect-top-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        padding: 0.38rem 0.85rem;
        border-radius: 999px;
        border: 1px solid color-mix(in oklab, var(--border) 70%, var(--primary));
        background: color-mix(in oklab, var(--surface) 88%, var(--bg));
        white-space: nowrap;
        transition:
          color 0.15s,
          background 0.15s,
          border-color 0.15s,
          box-shadow 0.15s,
          transform 0.15s;
      }
      .connect-top-link:hover {
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 10%, var(--surface));
        border-color: color-mix(in oklab, var(--primary) 35%, var(--border));
      }
      .connect-pill--primary {
        color: #fff;
        font-weight: 700;
        border-color: color-mix(in oklab, var(--primary) 55%, #0a5c62);
        background: linear-gradient(
          128deg,
          color-mix(in oklab, var(--primary) 88%, #fff) 0%,
          var(--primary) 48%,
          color-mix(in oklab, var(--primary) 78%, #0a3d42) 100%
        );
        box-shadow:
          inset 0 1px 0 color-mix(in srgb, #fff 22%, transparent),
          0 2px 10px color-mix(in oklab, var(--primary) 35%, transparent);
      }
      .connect-pill--primary:hover {
        color: #fff;
        transform: translateY(-1px);
        background: linear-gradient(
          128deg,
          color-mix(in oklab, var(--primary) 75%, #fff) 0%,
          color-mix(in oklab, var(--primary) 95%, #02b8b0) 50%,
          color-mix(in oklab, var(--primary) 70%, #065a60) 100%
        );
        border-color: color-mix(in oklab, var(--primary) 65%, #f0c96a);
        box-shadow:
          inset 0 1px 0 color-mix(in srgb, #fff 28%, transparent),
          0 4px 16px color-mix(in oklab, var(--primary) 42%, transparent);
      }
      .connect-top-link:focus-visible,
      .connect-pill:focus-visible {
        outline: 2px solid color-mix(in oklab, var(--primary) 50%, transparent);
        outline-offset: 2px;
      }
      .connect-theme-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
      }
      .connect-theme-btn:hover {
        color: var(--primary);
        border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      }

      /* Single booking card */
      .connect-flow {
        max-width: 52rem;
        margin: 0 auto;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: 0 8px 32px color-mix(in oklab, var(--text) 5%, transparent);
      }
      .connect-flow-body {
        display: grid;
        grid-template-columns: 1fr;
      }
      @media (min-width: 880px) {
        .connect-flow-body {
          grid-template-columns: 1fr 1fr;
        }
        .connect-flow-time {
          border-right: 1px solid var(--divider);
        }
      }
      .connect-flow-section {
        padding: 1.15rem 1.2rem 1.2rem;
        min-width: 0;
      }
      .connect-flow-label-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }
      .connect-flow-label {
        margin: 0;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--faint);
      }
      .connect-slots-panel--pulse {
        animation: connect-slots-pulse 0.85s ease-out;
      }
      @keyframes connect-slots-pulse {
        0%,
        100% {
          box-shadow: var(--shadow);
        }
        35%,
        65% {
          box-shadow:
            0 0 0 2px color-mix(in oklab, var(--primary) 45%, transparent),
            0 12px 28px color-mix(in oklab, var(--primary) 22%, transparent);
        }
      }
      .connect-slots-badge {
        font-size: 0.58rem;
        font-weight: 700;
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 10%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--primary) 22%, var(--border));
        padding: 0.14rem 0.45rem;
        border-radius: 999px;
        white-space: nowrap;
        margin-left: auto;
      }
      .connect-slots-signin-hint {
        margin: 0 0 0.75rem;
        font-size: 0.8rem;
        line-height: 1.45;
        color: var(--muted);
      }
      .connect-slots-signin-hint a {
        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
      }
      .connect-slots-signin-hint a:hover {
        text-decoration: underline;
      }
      .connect-my-bookings {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }
      .connect-avail-feed {
        width: 100%;
        min-height: min(12rem, 32vh);
        max-height: min(22rem, 50vh);
        overflow: auto;
        padding-right: 0.15rem;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in oklab, var(--primary) 35%, var(--border)) transparent;
      }
      .connect-avail-feed::-webkit-scrollbar {
        width: 5px;
      }
      .connect-avail-feed::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: color-mix(in oklab, var(--primary) 35%, var(--border));
      }
      .connect-service-row:hover {
        border-color: color-mix(in oklab, var(--row-accent) 45%, var(--border));
      }
      .connect-service-row--selected {
        box-shadow: 0 0 0 2px color-mix(in oklab, var(--row-accent) 35%, transparent);
      }
      .connect-service-meta {
        font-size: 0.72rem;
        color: var(--muted);
        margin-top: 0.35rem;
        line-height: 1.45;
      }
      .connect-cal-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
      }
      .connect-cal-nav-btn {
        width: 1.85rem;
        height: 1.85rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface2);
        color: var(--muted);
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
      }
      .connect-cal-nav-btn:hover {
        color: var(--primary);
        border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      }
      .connect-cal-label {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
      }
      .connect-cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.15rem;
        margin-bottom: 0.35rem;
      }
      .connect-cal-weekdays span {
        text-align: center;
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--faint);
        text-transform: uppercase;
      }
      .connect-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.2rem;
      }
      .connect-cal-day {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        border: 1px solid transparent;
        border-radius: 0.45rem;
        background: transparent;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 600;
        cursor: default;
        padding: 0;
      }
      .connect-cal-day--empty {
        visibility: hidden;
      }
      .connect-cal-day--has-slots {
        color: var(--text);
        cursor: pointer;
        background: color-mix(in oklab, var(--primary) 8%, var(--surface));
        border-color: color-mix(in oklab, var(--primary) 18%, var(--border));
      }
      .connect-cal-day--has-slots:hover {
        border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
        background: color-mix(in oklab, var(--primary) 14%, var(--surface));
      }
      .connect-cal-day--selected {
        color: var(--inv);
        background: var(--primary);
        border-color: var(--primary);
      }
      .connect-cal-day--selected::after {
        background: var(--inv);
      }
      .connect-cal-day--has-slots::after {
        content: '';
        position: absolute;
        bottom: 0.18rem;
        width: 0.28rem;
        height: 0.28rem;
        border-radius: 50%;
        background: var(--primary);
      }
      .connect-cal-hint {
        margin-top: 0.65rem;
        font-size: 0.68rem;
        line-height: 1.45;
        color: var(--faint);
      }
      .connect-services-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin-top: 0.15rem;
      }
      .connect-service-row {
        --row-accent: var(--primary);
        appearance: none;
        width: 100%;
        box-sizing: border-box;
        border: 1px solid color-mix(in oklab, var(--row-accent) 22%, var(--border));
        border-radius: 0.65rem;
        padding: 0.75rem 0.85rem;
        background: color-mix(in oklab, var(--row-accent) 5%, var(--surface));
        text-align: left;
        font: inherit;
        color: inherit;
        cursor: pointer;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .connect-service-row-head {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        margin-bottom: 0.55rem;
      }
      .connect-service-row-icon {
        font-size: 1.35rem;
        line-height: 1;
      }
      .connect-service-row-title {
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1.25;
      }
      .connect-service-row-benefit {
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--row-accent);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .connect-service-row-price {
        margin-left: auto;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--row-accent);
        white-space: nowrap;
      }
      .connect-time-chips {
        display: none;
      }
      .connect-flow-services .connect-flow-label {
        font-family: var(--font-display);
        font-size: 1.05rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        text-transform: none;
        color: var(--text);
        margin-bottom: 0.75rem;
      }
      .connect-other--awaiting-slot .connect-deck .connect-card {
        opacity: 0.5;
      }
      .connect-other--awaiting-slot .connect-deck .connect-card--soon {
        opacity: 0.85;
      }
      .connect-other--slot-selected .connect-deck .connect-card {
        opacity: 1;
      }
      .connect-card--service-picked {
        background: color-mix(in oklab, var(--royal-gold) 7%, var(--surface));
      }
      .connect-card--service-picked .connect-card-price {
        color: color-mix(in oklab, var(--royal-gold) 80%, var(--primary));
      }
      .connect-card--soon {
        cursor: pointer;
      }
      .connect-other--service-picked .connect-deck .connect-card:not(.connect-card--service-picked) {
        opacity: 0.65;
      }
      .connect-other--service-picked .connect-deck .connect-card:not(.connect-card--service-picked):hover {
        opacity: 0.9;
      }
      .connect-other--service-picked .connect-deck .connect-card--service-picked {
        opacity: 1;
      }
      .connect-booking-bar-note {
        font-size: 0.72rem;
        color: var(--muted);
        margin-top: 0.35rem;
      }
      .connect-flow-pay {
        padding: 1rem 1.2rem 1.15rem;
        border-top: 1px solid var(--divider);
        background: color-mix(in oklab, var(--primary) 4%, var(--surface));
      }
      .connect-booking-bar p {
        font-size: 0.84rem;
        line-height: 1.5;
        color: var(--text);
        margin-bottom: 0.65rem;
      }
      .connect-other {
        margin-bottom: 0;
        min-width: 0;
      }

      /* Service list */
      .connect-deck-slot-hint {
        margin: 0 0 0.65rem;
        padding: 0.5rem 0.65rem;
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.45;
        color: #b45309;
        background: color-mix(in oklab, #f59e0b 12%, var(--surface));
        border: 1px solid color-mix(in oklab, #f59e0b 35%, var(--border));
        border-radius: 0.5rem;
      }
      [data-theme='dark'] .connect-deck-slot-hint {
        color: #fbbf24;
        background: color-mix(in oklab, #f59e0b 14%, var(--surface));
        border-color: color-mix(in oklab, #f59e0b 40%, var(--border));
      }
      .connect-deck-slot-hint--flash {
        color: #c2410c;
        border-color: color-mix(in oklab, #ea580c 50%, var(--border));
        background: color-mix(in oklab, #f97316 16%, var(--surface));
      }
      [data-theme='dark'] .connect-deck-slot-hint--flash {
        color: #fdba74;
        background: color-mix(in oklab, #f97316 18%, var(--surface));
      }
      .connect-deck {
        display: flex;
        flex-direction: column;
        gap: 0;
      }
      .connect-card {
        appearance: none;
        width: 100%;
        font: inherit;
        cursor: pointer;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 0.8rem 0.35rem;
        text-align: left;
        background: transparent;
        border: none;
        border-bottom: 1px solid color-mix(in oklab, var(--royal-gold-soft) 30%, var(--divider));
        border-radius: 0;
        box-shadow: none;
        text-decoration: none;
        color: inherit;
        position: relative;
        transition: background 0.18s ease, opacity 0.18s ease;
      }
      .connect-card:last-child {
        border-bottom: none;
        padding-bottom: 0.35rem;
      }
      .connect-card:first-child {
        padding-top: 0.15rem;
      }
      .connect-card:hover {
        background: color-mix(in oklab, var(--royal-gold) 6%, transparent);
      }
      .connect-card:focus-visible {
        outline: 2px solid color-mix(in oklab, var(--royal-gold-soft) 55%, var(--primary));
        outline-offset: 2px;
        border-radius: 0.35rem;
        z-index: 1;
      }
      .connect-card-main {
        flex: 1;
        min-width: 0;
      }
      .connect-card-title {
        display: block;
        font-family: var(--font-display);
        font-size: 1.02rem;
        font-weight: 600;
        letter-spacing: -0.015em;
        line-height: 1.25;
        color: var(--text);
      }
      .connect-card-note {
        display: block;
        margin-top: 0.2rem;
        font-size: 0.72rem;
        font-style: italic;
        line-height: 1.35;
        color: var(--muted);
      }
      .connect-card-price {
        flex-shrink: 0;
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        color: color-mix(in oklab, var(--royal-gold) 65%, var(--primary));
        white-space: nowrap;
      }

      .connect-aside {
        margin: 1.35rem auto 0;
        max-width: 32rem;
        text-align: center;
        font-size: 0.8rem;
        line-height: 1.55;
        color: var(--muted);
      }
      .connect-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.72rem 1.35rem;
        border-radius: 0.55rem;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--inv);
        background: linear-gradient(135deg, var(--primary), color-mix(in oklab, var(--primary) 75%, #02a6a0));
        text-decoration: none;
        border: none;
        cursor: pointer;
        box-shadow:
          0 4px 14px color-mix(in oklab, var(--primary) 35%, transparent),
          inset 0 1px 0 color-mix(in srgb, #fff 25%, transparent);
        transition: transform 0.18s ease, box-shadow 0.18s ease;
      }
      .connect-cta-btn:hover {
        filter: brightness(1.05);
      }
      .connect-cta-btn:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 3px;
      }
      .connect-cta-sub {
        margin-top: 0.75rem;
        font-size: 0.72rem;
        color: var(--faint);
      }
      .connect-footnote {
        margin-top: 1rem;
        text-align: center;
        font-size: 0.65rem;
        line-height: 1.5;
        color: var(--faint);
      }
      .connect-footnote-star {
        color: var(--primary);
        font-weight: 700;
        margin-right: 0.2rem;
      }
      .connect-detail {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: max(0.75rem, env(safe-area-inset-top, 0px)) max(0.75rem, env(safe-area-inset-right, 0px))
          max(0.75rem, env(safe-area-inset-bottom, 0px)) max(0.75rem, env(safe-area-inset-left, 0px));
        box-sizing: border-box;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.18s ease;
      }
      .connect-detail.active {
        opacity: 1;
        pointer-events: all;
      }
      .connect-detail-backdrop {
        position: absolute;
        inset: 0;
        border: none;
        padding: 0;
        margin: 0;
        cursor: pointer;
        background: color-mix(in oklab, var(--text) 52%, transparent);
      }
      [data-theme='dark'] .connect-detail-backdrop {
        background: rgba(0, 0, 0, 0.72);
      }
      .connect-detail-panel {
        position: relative;
        z-index: 1;
        width: min(100%, 24rem);
        max-height: min(88vh, 34rem);
        overflow: auto;
        padding: 1.35rem 1.25rem 1.2rem;
        border-radius: 1rem;
        background: var(--surface);
        border: 1px solid color-mix(in oklab, var(--border) 80%, var(--detail-accent, var(--primary)));
        box-shadow:
          var(--shadow),
          0 18px 48px color-mix(in oklab, var(--detail-accent, var(--primary)) 18%, transparent);
        transform: translateY(12px) scale(0.98);
        transition: transform 0.2s ease;
      }
      .connect-detail.active .connect-detail-panel {
        transform: translateY(0) scale(1);
      }
      .connect-detail-close {
        position: absolute;
        top: 0.65rem;
        right: 0.65rem;
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--border);
        border-radius: 0.45rem;
        background: var(--surface2);
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s, background 0.15s;
      }
      .connect-detail-close:hover {
        color: var(--text);
        border-color: color-mix(in oklab, var(--detail-accent, var(--primary)) 35%, var(--border));
      }
      .connect-detail-icon {
        font-size: 2rem;
        line-height: 1;
        margin-bottom: 0.35rem;
      }
      .connect-detail-benefit {
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--detail-accent, var(--primary));
        margin-bottom: 0.25rem;
      }
      .connect-detail-title {
        font-size: 1.2rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--text);
        margin-bottom: 0.55rem;
        padding-right: 1.75rem;
        line-height: 1.25;
      }
      .connect-detail-hook {
        font-size: 0.84rem;
        line-height: 1.55;
        color: var(--muted);
        margin-bottom: 0.9rem;
      }
      .connect-detail-price {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.2rem 0.35rem;
        margin-bottom: 0.55rem;
        padding: 0.65rem 0.75rem;
        border-radius: 0.65rem;
        background: color-mix(in oklab, var(--detail-accent, var(--primary)) 9%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--detail-accent, var(--primary)) 22%, var(--border));
      }
      .connect-detail-price-amt {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--detail-accent, var(--primary));
        letter-spacing: -0.02em;
        line-height: 1;
      }
      .connect-detail-price-period {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--muted);
        line-height: 1.2;
      }
      .connect-detail-note {
        font-size: 0.68rem;
        line-height: 1.5;
        color: var(--faint);
        margin-bottom: 1rem;
      }
      .connect-detail-book {
        width: 100%;
        box-sizing: border-box;
      }
      .connect-detail-soon-badge {
        display: inline-block;
        margin-bottom: 0.65rem;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.58rem;
        font-weight: 800;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        color: #5b21b6;
        background: color-mix(in oklab, var(--detail-accent, #6d28d9) 12%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--detail-accent, #6d28d9) 28%, var(--border));
      }
      [data-theme='dark'] .connect-detail-soon-badge {
        color: #ddd6fe;
      }
      .connect-detail-interest {
        margin-bottom: 0.5rem;
      }
      .connect-detail-interest-lead {
        font-size: 0.82rem;
        line-height: 1.55;
        color: var(--muted);
        margin: 0 0 0.85rem;
      }
      .connect-detail-interest-label {
        display: block;
        font-size: 0.68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--faint);
        margin-bottom: 0.35rem;
      }
      .connect-detail-interest-note {
        width: 100%;
        box-sizing: border-box;
        min-height: 4.5rem;
        resize: vertical;
        padding: 0.6rem 0.7rem;
        margin-bottom: 0.75rem;
        border-radius: 0.55rem;
        border: 1px solid var(--border);
        background: var(--surface2);
        color: var(--text);
        font: inherit;
        font-size: 0.8rem;
        line-height: 1.45;
      }
      .connect-detail-interest-note:focus {
        outline: none;
        border-color: color-mix(in oklab, var(--detail-accent, var(--primary)) 45%, var(--border));
        box-shadow: 0 0 0 2px color-mix(in oklab, var(--detail-accent, var(--primary)) 18%, transparent);
      }
      .connect-detail-interest-status {
        font-size: 0.78rem;
        line-height: 1.45;
        margin: 0 0 0.65rem;
        padding: 0.55rem 0.65rem;
        border-radius: 0.5rem;
        background: color-mix(in oklab, var(--primary) 8%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--primary) 22%, var(--border));
        color: var(--text);
      }
      .connect-detail-interest-status--done {
        background: color-mix(in oklab, #16a34a 10%, var(--surface));
        border-color: color-mix(in oklab, #16a34a 28%, var(--border));
        color: color-mix(in oklab, #15803d 85%, var(--text));
      }
      [data-theme='dark'] .connect-detail-interest-status--done {
        color: #86efac;
      }
      .connect-detail-interest-btn:disabled {
        opacity: 0.65;
        cursor: not-allowed;
      }
      .connect-detail-slots {
        margin-bottom: 1rem;
      }
      .connect-detail-slots-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--faint);
        margin-bottom: 0.5rem;
      }
      .connect-slot-list {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        max-height: 11rem;
        overflow-y: auto;
        margin-bottom: 0.75rem;
      }
      .connect-slot-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.55rem 0.65rem;
        border-radius: 0.55rem;
        border: 1px solid var(--border);
        background: var(--surface2);
        font-size: 0.78rem;
      }
      .connect-slot-item strong {
        font-weight: 700;
        color: var(--text);
      }
      .connect-slot-pick {
        flex-shrink: 0;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 0.35rem 0.6rem;
        border-radius: 0.4rem;
        border: 1px solid color-mix(in oklab, var(--detail-accent, var(--primary)) 40%, var(--border));
        background: color-mix(in oklab, var(--detail-accent, var(--primary)) 10%, var(--surface));
        color: var(--detail-accent, var(--primary));
        cursor: pointer;
      }
      .connect-slot-pick:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }
      .connect-slot-empty {
        font-size: 0.78rem;
        color: var(--muted);
        line-height: 1.5;
        padding: 0.5rem 0;
      }
      .connect-slot-reserved {
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--text);
        padding: 0.65rem 0.75rem;
        border-radius: 0.55rem;
        background: color-mix(in oklab, var(--detail-accent, var(--primary)) 9%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--detail-accent, var(--primary)) 22%, var(--border));
        margin-bottom: 0.75rem;
      }
      .connect-detail-mentor-link {
        display: inline-block;
        margin-bottom: 0.75rem;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--primary);
        text-decoration: none;
      }
      .connect-detail-mentor-link:hover {
        text-decoration: underline;
      }
      .connect-email-link {
        color: var(--primary);
        font-weight: 600;
        text-decoration: none;
      }
      .connect-email-link:hover {
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .connect-avail-feed {
          min-height: 0;
          max-height: min(14rem, 38vh);
        }
      }
    </style>
  </head>
  <body>
    <div class="connect-page">
      <div class="connect-shell">
        <header class="connect-top">
          <a class="connect-brand" href="/">
            <LogoMark width={28} height={28} />
            <div>
              <div class="connect-brand-text">DSA Mastery</div>
              <div class="connect-brand-sub">algofrog.in</div>
            </div>
          </a>
          <div class="connect-top-actions">
            <DiscordJoin variant="pill" />
            <a class="connect-top-link connect-pill" href="/login?redirect=/connect" id="connect-nav-auth">Sign in</a>
            <button class="connect-theme-btn" id="connect-theme" type="button" aria-label="Toggle theme">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
              </svg>
            </button>
          </div>
        </header>

        <main>
          <header class="connect-intro">
            <h1 class="connect-intro-title">Book a <em>live session</em></h1>
          </header>

          <div class="connect-flow">
            <div class="connect-flow-body">
              <section class="connect-flow-section connect-flow-time connect-slots-panel" aria-label="Pick a time">
                <div class="connect-flow-label-row">
                  <h2 class="connect-flow-label">Time</h2>
                  <span class="connect-slots-badge" id="connect-slots-count" hidden></span>
                </div>
                <p class="connect-slots-signin-hint" id="connect-slots-signin-hint" hidden>
                  <a href="/login?redirect=/connect">Sign in</a> to pick a slot.
                </p>
                <div id="connect-my-bookings" class="connect-my-bookings" hidden aria-label="Your booked sessions"></div>
                <div class="connect-avail-feed" id="connect-avail-feed" aria-label="Date and time slots"></div>
              </section>

              <section
                class="connect-flow-section connect-flow-services connect-other connect-other--awaiting-slot"
                id="connect-service-deck"
                aria-label="Choose your service"
              >
                <h2 class="connect-flow-label">Choose a session</h2>
                <p class="connect-deck-slot-hint" id="connect-deck-slot-hint" hidden role="status" aria-live="polite">
                  Pick a time first, then choose a service.
                </p>
                <div class="connect-deck" role="list">
                  {
                    services.map((s, i) => (
                      <button
                        type="button"
                        class:list={['connect-card', s.comingSoon && 'connect-card--soon']}
                        role="listitem"
                        style={`--i: ${i}`}
                        data-connect-id={s.id}
                        data-connect-bookable={isConnectSlotBookable(s) ? '1' : '0'}
                        data-connect-coming-soon={s.comingSoon ? '1' : '0'}
                        title={s.comingSoon ? `${s.title} — ${connectBatchCopy.cardHint}` : s.hook}
                      >
                        <span class="connect-card-main">
                          <span class="connect-card-title">{s.title}</span>
                          {s.comingSoon && (
                            <span class="connect-card-note">{connectBatchCopy.cardHint}</span>
                          )}
                        </span>
                        <span class="connect-card-price">{s.price}</span>
                      </button>
                    ))
                  }
                </div>
              </section>
            </div>

            <div class="connect-flow-pay connect-booking-bar" id="connect-booking-bar" hidden>
              <p id="connect-booking-msg"></p>
              <p class="connect-booking-bar-note" id="connect-booking-note" hidden>
                Change service above before paying. Slot held for 7 minutes after you start checkout.
              </p>
              <button type="button" class="connect-cta-btn" id="connect-booking-pay" hidden>Pay to confirm →</button>
            </div>
          </div>

          <p class="connect-aside">
            Not sure where to start? <DiscordJoin variant="link" /> — DM your goal and level.
          </p>

          <a href="/admin" id="connect-avail-link" hidden>Admin</a>

          <p class="connect-footnote">
            <span class="connect-footnote-star" aria-hidden="true">*</span>
            {sessionFootnote}
          </p>
        </main>
      </div>
    </div>

    <div
      id="connect-detail"
      class="connect-detail"
      role="dialog"
      aria-modal="true"
      aria-labelledby="connect-detail-title"
      aria-hidden="true"
      hidden
    >
      <button type="button" class="connect-detail-backdrop" id="connect-detail-backdrop" aria-label="Close details"></button>
      <div class="connect-detail-panel">
        <button type="button" class="connect-detail-close" id="connect-detail-close" aria-label="Close">✕</button>
        <div class="connect-detail-icon" id="connect-detail-icon" aria-hidden="true"></div>
        <p class="connect-detail-benefit" id="connect-detail-benefit"></p>
        <h2 class="connect-detail-title" id="connect-detail-title"></h2>
        <p class="connect-detail-hook" id="connect-detail-hook"></p>
        <span class="connect-detail-soon-badge" id="connect-detail-soon-badge" hidden>{connectBatchCopy.badge}</span>
        <div class="connect-detail-price" id="connect-detail-price-wrap">
          <span class="connect-detail-price-amt" id="connect-detail-price-amt"></span>
          <span class="connect-detail-price-period" id="connect-detail-price-period"></span>
        </div>
        <div class="connect-detail-interest" id="connect-detail-interest" hidden>
          <p class="connect-detail-interest-lead" id="connect-detail-interest-lead">
            {connectBatchCopy.modalLead}
          </p>
          <label class="connect-detail-interest-label" for="connect-detail-interest-note">
            Your level & topics (optional)
          </label>
          <textarea
            class="connect-detail-interest-note"
            id="connect-detail-interest-note"
            rows="3"
            maxlength="500"
            placeholder="e.g. Student · trees, graphs, DP · targeting SDE-2 in 6 months"
          ></textarea>
          <p class="connect-detail-interest-status" id="connect-detail-interest-status" hidden role="status"></p>
          <button type="button" class="connect-cta-btn connect-detail-interest-btn" id="connect-detail-interest-btn">
            {connectBatchCopy.cta}
          </button>
        </div>
        <p class="connect-detail-note" id="connect-detail-footnote">{sessionFootnote}</p>
        <div class="connect-detail-slots" id="connect-detail-slots" hidden>
          <p class="connect-detail-slots-label">Pick a session time</p>
          <div class="connect-slot-list" id="connect-slot-list"></div>
          <div class="connect-slot-reserved" id="connect-slot-reserved" hidden></div>
          <button type="button" class="connect-cta-btn connect-detail-book" id="connect-detail-pay" hidden>
            Pay to confirm →
          </button>
        </div>
        <a class="connect-cta-btn connect-detail-book" id="connect-detail-book" href="#">Book via email →</a>
      </div>
    </div>

    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script id="connect-offerings-data" type="application/json" set:html={JSON.stringify(connectOfferings)} />

    <script>
      import { supabase } from '../lib/supabase';
      import type { ConnectService } from '../data/connect-services';
      import { connectSessionPricePaise, connectBatchCopy } from '../data/connect-services';
      import { loadConnectSlots, loadMyConnectBookings, type ConnectSlot } from '../lib/connect-slots';
      import { fetchIsAdmin, setAdminNavLink } from '../lib/admin-access';
      import { showConnectPendingOverlay } from '../lib/payment-overlay';
      import { connectPaymentNotes, resolveConnectCheckout, waitForConnectPaid } from '../lib/payment-await';

      const IST = 'Asia/Kolkata';
      const dateFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        weekday: 'short',
        day: 'numeric',
        month: 'short',
      });
      const timeFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      });
      const dayMonthFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        day: 'numeric',
        month: 'short',
      });
      const weekdayFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        weekday: 'short',
      });

      const SLOT_COLUMNS = 3;

      type SlotRow = ConnectSlot;

      const offeringsEl = document.getElementById('connect-offerings-data');
      const offerings: ConnectService[] = offeringsEl?.textContent
        ? JSON.parse(offeringsEl.textContent)
        : [];
      const availFeed = document.getElementById('connect-avail-feed');
      const myBookingsPanel = document.getElementById('connect-my-bookings');
      const slotsCountBadge = document.getElementById('connect-slots-count');
      const serviceDeck = document.getElementById('connect-service-deck');
      const bookingBar = document.getElementById('connect-booking-bar');
      const bookingMsg = document.getElementById('connect-booking-msg');
      const bookingNote = document.getElementById('connect-booking-note');
      const bookingPay = document.getElementById('connect-booking-pay') as HTMLButtonElement | null;
      const deckSlotHint = document.getElementById('connect-deck-slot-hint');
      const slotsSignInHint = document.getElementById('connect-slots-signin-hint');
      const slotsPanel = document.querySelector('.connect-slots-panel');

      const detailRoot = document.getElementById('connect-detail');
      const detailBackdrop = document.getElementById('connect-detail-backdrop');
      const detailClose = document.getElementById('connect-detail-close');
      const detailBook = document.getElementById('connect-detail-book') as HTMLAnchorElement | null;
      const detailSoonBadge = document.getElementById('connect-detail-soon-badge');
      const detailPriceWrap = document.getElementById('connect-detail-price-wrap');
      const detailInterest = document.getElementById('connect-detail-interest');
      const detailInterestNote = document.getElementById('connect-detail-interest-note') as HTMLTextAreaElement | null;
      const detailInterestStatus = document.getElementById('connect-detail-interest-status');
      const detailInterestBtn = document.getElementById('connect-detail-interest-btn') as HTMLButtonElement | null;
      const detailFootnote = document.getElementById('connect-detail-footnote');
      const availLink = document.getElementById('connect-avail-link');

      let authSession: Awaited<ReturnType<typeof supabase.auth.getSession>>['data']['session'] = null;
      let interestServiceId: string | null = null;
      let activeOffering: ConnectService | null = null;
      let reservedSlot: SlotRow | null = null;
      let allSlots: SlotRow[] = [];
      let myBookings: SlotRow[] = [];
      let selectedDateKey: string | null = null;
      let selectedSlotId: number | null = null;
      let activeHoldSlotId: number | null = null;

      const dayKeyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: IST });

      function istDateKey(iso: string) {
        return dayKeyFmt.format(new Date(iso));
      }

      function todayKey() {
        return dayKeyFmt.format(new Date());
      }

      function requireConnectAuth(): boolean {
        if (authSession) return true;
        window.location.href = '/login?redirect=/connect';
        return false;
      }

      function syncConnectAuthUi() {
        if (slotsSignInHint) slotsSignInHint.hidden = !!authSession;
      }

      async function releaseActiveHold() {
        if (activeHoldSlotId == null) return;
        const slotId = activeHoldSlotId;
        activeHoldSlotId = null;
        const { error } = await supabase.rpc('release_my_connect_slot_hold', { p_slot_id: slotId });
        if (error) console.error('Failed to release slot hold:', error);
      }

      function resetBookingBar() {
        reservedSlot = null;
        activeOffering = null;
        if (bookingBar) bookingBar.hidden = true;
        if (bookingPay) bookingPay.hidden = true;
        if (bookingNote) bookingNote.hidden = true;
        if (bookingMsg) bookingMsg.textContent = '';
        syncServicePickHighlight();
      }

      function syncServicePickHighlight() {
        serviceDeck?.classList.toggle(
          'connect-other--service-picked',
          !!selectedSlotId && !!activeOffering,
        );
        document.querySelectorAll('.connect-deck .connect-card[data-connect-id]').forEach((el) => {
          const id = el.getAttribute('data-connect-id');
          if (el.getAttribute('data-connect-coming-soon') === '1') {
            el.classList.remove('connect-card--service-picked');
            el.setAttribute('aria-pressed', 'false');
            return;
          }
          el.classList.toggle('connect-card--service-picked', !!activeOffering && id === activeOffering.id);
          el.setAttribute('aria-pressed', !!activeOffering && id === activeOffering.id ? 'true' : 'false');
        });
      }

      async function clearTimeSelection() {
        selectedSlotId = null;
        selectedDateKey = null;
        resetBookingBar();
        updateDeckState();
        renderAvailabilityFeed();
        if (document.activeElement instanceof HTMLElement) {
          document.activeElement.blur();
        }

        await releaseActiveHold();
        await loadAllSlots();
      }

      function updateDeckState() {
        serviceDeck?.classList.toggle('connect-other--awaiting-slot', !selectedSlotId);
        serviceDeck?.classList.toggle('connect-other--slot-selected', !!selectedSlotId);
        if (deckSlotHint && selectedSlotId) deckSlotHint.hidden = true;
        document.querySelectorAll('.connect-deck .connect-card[data-connect-id]').forEach((card) => {
          const cta = card.querySelector('.connect-card-cta');
          if (!cta) return;
          if (card.getAttribute('data-connect-coming-soon') === '1') {
            cta.textContent = connectBatchCopy.cta;
            return;
          }
          cta.textContent = selectedSlotId ? 'Book this →' : 'Pick a time first →';
        });
        syncServicePickHighlight();
      }

      function promptPickSlotFirst() {
        if (deckSlotHint) {
          deckSlotHint.hidden = false;
          deckSlotHint.classList.remove('connect-deck-slot-hint--flash');
          void deckSlotHint.offsetWidth;
          deckSlotHint.classList.add('connect-deck-slot-hint--flash');
        }
        slotsPanel?.classList.remove('connect-slots-panel--pulse');
        void (slotsPanel as HTMLElement | null)?.offsetWidth;
        slotsPanel?.classList.add('connect-slots-panel--pulse');
        slotsPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        window.setTimeout(() => {
          slotsPanel?.classList.remove('connect-slots-panel--pulse');
          deckSlotHint?.classList.remove('connect-deck-slot-hint--flash');
        }, 900);
      }

      function serviceTitle(serviceId: string) {
        return offerings.find((o) => o.id === serviceId)?.title ?? serviceId;
      }

      function formatBookingWhen(startsAt: string) {
        const d = new Date(startsAt);
        const date = `${weekdayFmt.format(d)}, ${dayMonthFmt.format(d)}`;
        const time = timeFmt.format(d);
        return { date, time, full: `${date} · ${time}` };
      }

      function buildMyBookingRow(slot: SlotRow) {
        const when = formatBookingWhen(slot.starts_at);
        const row = document.createElement('div');
        row.className = 'connect-my-bookings-row';

        const main = document.createElement('div');
        main.className = 'connect-my-bookings-main';

        const service = document.createElement('strong');
        service.className = 'connect-my-bookings-service';
        service.textContent = serviceTitle(slot.service_id);

        const whenEl = document.createElement('span');
        whenEl.className = 'connect-my-bookings-when';
        whenEl.textContent = when.full;

        main.appendChild(service);
        main.appendChild(whenEl);

        const status = document.createElement('span');
        status.className = 'connect-my-bookings-status';
        status.textContent = 'Booked';

        row.appendChild(main);
        row.appendChild(status);
        row.title = `${serviceTitle(slot.service_id)} — ${when.full} (confirmed)`;
        return row;
      }

      function buildBookedPill(slot: SlotRow) {
        const span = document.createElement('span');
        const held = slot.status === 'reserved';
        span.className =
          'connect-slot-pill connect-slot-pill--booked' + (held ? ' connect-slot-pill--held' : '');
        const when = timeFmt.format(new Date(slot.starts_at));
        span.textContent = held ? `${when} · hold` : `${when} · booked`;
        span.title = held
          ? `${serviceTitle(slot.service_id)} · checkout hold`
          : `${serviceTitle(slot.service_id)} · your confirmed session`;
        return span;
      }

      function buildSlotButton(slot: SlotRow) {
        const selected = slot.id === selectedSlotId;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'connect-slot-pill connect-time-slot-btn';
        if (selected) {
          btn.classList.add('connect-slot-pill--selected', 'connect-time-slot-btn--selected');
        }
        btn.textContent = timeFmt.format(new Date(slot.starts_at));
        btn.setAttribute('data-slot-id', String(slot.id));
        btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
        btn.setAttribute(
          'aria-label',
          `${dayMonthFmt.format(new Date(slot.starts_at))} at ${timeFmt.format(new Date(slot.starts_at))}`,
        );
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          selectTimeSlot(slot);
        });
        return btn;
      }

      type FeedCell = { slot: SlotRow; kind: 'open' | 'mine' };

      function renderMyBookingsPanel() {
        if (!myBookingsPanel) return;
        const paid = myBookings.filter((b) => b.status === 'paid');
        if (!paid.length) {
          myBookingsPanel.hidden = true;
          myBookingsPanel.innerHTML = '';
          return;
        }

        myBookingsPanel.hidden = false;
        const heading =
          paid.length === 1 ? 'Your upcoming session' : `Your upcoming sessions (${paid.length})`;
        myBookingsPanel.innerHTML = `<p class="connect-my-bookings-label">${heading}</p>`;
        for (const slot of paid) {
          myBookingsPanel.appendChild(buildMyBookingRow(slot));
        }
      }

      function renderAvailabilityFeed() {
        if (!availFeed) return;

        renderMyBookingsPanel();

        const byDate = new Map<string, FeedCell[]>();
        const seenIds = new Set<number>();

        for (const slot of allSlots) {
          const key = istDateKey(slot.starts_at);
          const list = byDate.get(key) ?? [];
          list.push({ slot, kind: 'open' });
          seenIds.add(slot.id);
          byDate.set(key, list);
        }

        for (const slot of myBookings) {
          if (seenIds.has(slot.id)) continue;
          const key = istDateKey(slot.starts_at);
          const list = byDate.get(key) ?? [];
          list.push({ slot, kind: 'mine' });
          byDate.set(key, list);
        }

        const paidCount = myBookings.filter((b) => b.status === 'paid').length;

        if (!byDate.size && !paidCount) {
          availFeed.innerHTML = '<p class="connect-avail-empty">No open slots right now. Check back soon.</p>';
          if (slotsCountBadge) slotsCountBadge.hidden = true;
          return;
        }

        if (!byDate.size) {
          availFeed.innerHTML =
            '<p class="connect-avail-empty">No other open slots right now. Your session is listed above.</p>';
          if (slotsCountBadge) {
            slotsCountBadge.hidden = false;
            slotsCountBadge.textContent = `${paidCount} booked`;
          }
          return;
        }

        if (slotsCountBadge) {
          slotsCountBadge.hidden = false;
          const parts: string[] = [];
          if (paidCount) parts.push(`${paidCount} booked`);
          if (allSlots.length) parts.push(`${allSlots.length} open`);
          slotsCountBadge.textContent = parts.join(' · ') || 'Your booking';
        }

        const rows = [...byDate.entries()].sort(([a], [b]) => a.localeCompare(b));
        for (const [, cells] of rows) {
          cells.sort((a, b) => {
            if (a.kind !== b.kind) return a.kind === 'mine' ? -1 : 1;
            return a.slot.starts_at.localeCompare(b.slot.starts_at);
          });
        }

        const bookingFirstRows = rows.filter(([, cells]) => cells.some((c) => c.kind === 'mine'));
        const openOnlyRows = rows.filter(([, cells]) => !cells.some((c) => c.kind === 'mine'));
        const orderedRows = [...bookingFirstRows, ...openOnlyRows];

        const today = todayKey();

        const table = document.createElement('table');
        table.className = 'connect-avail-table';
        table.setAttribute('role', 'grid');
        table.setAttribute('aria-label', 'Available session times and your bookings');

        const thead = document.createElement('thead');
        const headRow = document.createElement('tr');
        headRow.innerHTML = '<th>Date</th><th>Slot 1</th><th>Slot 2</th><th>Slot 3</th>';
        thead.appendChild(headRow);
        table.appendChild(thead);

        const tbody = document.createElement('tbody');
        for (const [dateKey, cells] of orderedRows) {
          const tr = document.createElement('tr');
          if (dateKey === today) tr.classList.add('connect-avail-row--today');
          const hasMine = cells.some((c) => c.kind === 'mine');
          if (hasMine) tr.classList.add('connect-avail-row--mine');

          const dateTd = document.createElement('td');
          const dateCell = document.createElement('div');
          dateCell.className = 'connect-avail-date-cell';

          const wd = document.createElement('span');
          wd.className = 'connect-avail-day-wd';
          wd.textContent = weekdayFmt.format(new Date(cells[0].slot.starts_at));

          const dm = document.createElement('span');
          dm.className = 'connect-avail-day-dm';
          dm.textContent = dayMonthFmt.format(new Date(cells[0].slot.starts_at));

          dateCell.appendChild(wd);
          dateCell.appendChild(dm);
          dateTd.appendChild(dateCell);
          tr.appendChild(dateTd);

          for (let i = 0; i < SLOT_COLUMNS; i++) {
            const td = document.createElement('td');
            td.className = 'connect-avail-slot-cell';
            td.setAttribute('role', 'gridcell');
            const cell = cells[i];
            if (cell) {
              td.appendChild(cell.kind === 'open' ? buildSlotButton(cell.slot) : buildBookedPill(cell.slot));
            } else {
              td.classList.add('connect-avail-slot-cell--empty');
              td.textContent = '—';
            }
            tr.appendChild(td);
          }

          tbody.appendChild(tr);
        }
        table.appendChild(tbody);

        availFeed.innerHTML = '';
        availFeed.appendChild(table);
      }

      function selectTimeSlot(slot: SlotRow) {
        if (selectedSlotId === slot.id) {
          void clearTimeSelection();
          return;
        }
        if (!requireConnectAuth()) return;

        selectedSlotId = slot.id;
        selectedDateKey = istDateKey(slot.starts_at);
        resetBookingBar();
        renderAvailabilityFeed();
        updateDeckState();
      }

      function pickServiceForSlot(svc: ConnectService) {
        if (svc.comingSoon) return;
        if (!requireConnectAuth()) return;

        const slot = allSlots.find((s) => s.id === selectedSlotId);
        if (!slot) return;

        reservedSlot = slot;
        activeOffering = svc;
        showBookingBar();
      }

      function handleDeckClick(id: string, _el: HTMLElement) {
        const svc = offerings.find((o) => o.id === id);
        if (svc?.comingSoon) {
          void openConnectInterest(svc);
          return;
        }

        if (!selectedSlotId) {
          promptPickSlotFirst();
          return;
        }

        if (svc) pickServiceForSlot(svc);
      }

      function showBookingBar() {
        if (!reservedSlot || !activeOffering || !bookingBar || !bookingMsg || !bookingPay) return;
        bookingBar.hidden = false;
        if (bookingNote) bookingNote.hidden = false;

        const when = `${timeFmt.format(new Date(reservedSlot.starts_at))} on ${dateFmt.format(new Date(reservedSlot.starts_at))} (IST)`;
        const paise = connectSessionPricePaise(activeOffering);

        if (!paise) {
          bookingPay.hidden = true;
          bookingMsg.textContent = 'Payment is unavailable for this service. Pick another service or contact support.';
          syncServicePickHighlight();
          return;
        }

        bookingPay.hidden = false;
        bookingPay.textContent = `Pay ₹${(paise / 100).toFixed(0)} to confirm →`;
        bookingMsg.innerHTML = `Selected <strong>${activeOffering.title}</strong> at ${when}. Complete payment to confirm your booking.`;

        syncServicePickHighlight();
      }

      async function loadAllSlots() {
        const previousPaid = myBookings.filter((b) => b.status === 'paid');
        const [open, mine] = await Promise.all([loadConnectSlots(), loadMyConnectBookings()]);
        allSlots = open;
        const serverIds = new Set(mine.map((b) => b.id));
        const keepLocal = previousPaid.filter((b) => !serverIds.has(b.id));
        myBookings = [...mine, ...keepLocal].sort((a, b) => a.starts_at.localeCompare(b.starts_at));
        renderAvailabilityFeed();
        updateDeckState();
      }

      async function openConnectPayment() {
        if (!requireConnectAuth()) return;
        if (!reservedSlot || !activeOffering || !bookingPay) return;

        const paise = connectSessionPricePaise(activeOffering);
        if (!paise) return;

        const payLabel = `Pay ₹${(paise / 100).toFixed(0)} to confirm →`;
        bookingPay.disabled = true;
        bookingPay.textContent = 'Reserving slot…';

        const { error: holdError } = await supabase.rpc('hold_connect_slot', {
          p_service_id: activeOffering.id,
          p_slot_id: reservedSlot.id,
        });

        if (holdError) {
          bookingPay.disabled = false;
          bookingPay.textContent = payLabel;
          alert(holdError.message || 'This slot was just taken. Pick another time.');
          await clearTimeSelection();
          return;
        }

        activeHoldSlotId = reservedSlot.id;

        bookingPay.disabled = false;
        bookingPay.textContent = payLabel;

        const slotId = reservedSlot.id;
        const slotLabel = `${dateFmt.format(new Date(reservedSlot.starts_at))} ${timeFmt.format(new Date(reservedSlot.starts_at))}`;

        const checkout = await resolveConnectCheckout(slotId, activeOffering!.id, paise);
        if (checkout.orderError) {
          console.warn('razorpay-create-order:', checkout.orderError);
        }

        const options = {
          key: import.meta.env.PUBLIC_RAZORPAY_KEY_ID,
          ...(checkout.orderId ? { order_id: checkout.orderId } : {}),
          amount: checkout.amount,
          currency: 'INR',
          name: 'algofrog.in',
          description: `${activeOffering.title} session — ${slotLabel}`,
          notes: connectPaymentNotes(authSession.user.id, slotId, activeOffering!.id, paise),
          prefill: {
            email: authSession.user.email,
            name: authSession.user.user_metadata?.full_name || '',
          },
          theme: { color: '#0f766e' },
          modal: {
            ondismiss: () => {
              void (async () => {
                await releaseActiveHold();
                await loadAllSlots();
              })();
            },
          },
          handler: async (response: { razorpay_payment_id: string }) => {
            const paymentId = response.razorpay_payment_id;
            const userId = authSession!.user.id;
            const ok = await waitForConnectPaid(slotId, paymentId, userId);
            if (!ok) {
              showConnectPendingOverlay();
              return;
            }
            activeHoldSlotId = null;
            if (reservedSlot && activeOffering) {
              myBookings = [
                {
                  id: slotId,
                  service_id: activeOffering.id,
                  starts_at: reservedSlot.starts_at,
                  ends_at: reservedSlot.ends_at,
                  status: 'paid',
                },
                ...myBookings.filter((b) => b.id !== slotId),
              ];
              renderAvailabilityFeed();
            }
            alert('Session confirmed! You will receive meeting details by email.');
            await clearTimeSelection();
          },
        };
        const rzp = new (window as Window & { Razorpay?: new (o: typeof options) => { open: () => void } }).Razorpay!(options);
        rzp.open();
      }

      bookingPay?.addEventListener('click', () => {
        void openConnectPayment();
      });

      function resetDetailModes() {
        if (detailSoonBadge) detailSoonBadge.hidden = true;
        if (detailInterest) detailInterest.hidden = true;
        if (detailBook) detailBook.hidden = true;
        if (detailPriceWrap) detailPriceWrap.hidden = false;
        if (detailFootnote) detailFootnote.hidden = false;
        if (detailInterestStatus) {
          detailInterestStatus.hidden = true;
          detailInterestStatus.textContent = '';
          detailInterestStatus.classList.remove('connect-detail-interest-status--done');
        }
        if (detailInterestNote) detailInterestNote.value = '';
        if (detailInterestBtn) {
          detailInterestBtn.disabled = false;
          detailInterestBtn.textContent = connectBatchCopy.cta;
        }
        interestServiceId = null;
      }

      function showInterestRegistered() {
        if (!detailInterestStatus || !detailInterestBtn) return;
        detailInterestStatus.hidden = false;
        detailInterestStatus.classList.add('connect-detail-interest-status--done');
        detailInterestStatus.textContent = connectBatchCopy.success;
        detailInterestBtn.textContent = 'Update note →';
      }

      async function openConnectInterest(item: ConnectService) {
        if (!detailRoot) return;
        resetDetailModes();
        interestServiceId = item.id;

        detailRoot.style.setProperty('--detail-accent', item.accent);
        const iconEl = document.getElementById('connect-detail-icon');
        const benefitEl = document.getElementById('connect-detail-benefit');
        const titleEl = document.getElementById('connect-detail-title');
        const hookEl = document.getElementById('connect-detail-hook');
        const priceAmtEl = document.getElementById('connect-detail-price-amt');
        const pricePeriodEl = document.getElementById('connect-detail-price-period');

        if (iconEl) iconEl.textContent = item.icon;
        if (benefitEl) benefitEl.textContent = item.benefit;
        if (titleEl) titleEl.textContent = item.title;
        if (hookEl) hookEl.textContent = item.hook;
        if (priceAmtEl) priceAmtEl.textContent = item.price;
        if (pricePeriodEl) {
          pricePeriodEl.textContent = `${item.pricePeriod ?? ''} · ${connectBatchCopy.priceSuffix}`.trim();
        }
        if (detailSoonBadge) detailSoonBadge.hidden = false;
        if (detailInterest) detailInterest.hidden = false;
        if (detailBook) detailBook.hidden = true;

        if (authSession) {
          const { data: onList, error } = await supabase.rpc('has_connect_interest', {
            p_service_id: item.id,
          });
          if (!error && onList) showInterestRegistered();
        } else if (detailInterestBtn) {
          detailInterestBtn.textContent = connectBatchCopy.signInCta;
        }

        detailRoot.hidden = false;
        detailRoot.setAttribute('aria-hidden', 'false');
        detailRoot.classList.add('active');
        document.body.style.overflow = 'hidden';
        detailClose?.focus();
      }

      async function submitConnectInterest() {
        if (!interestServiceId || !detailInterestBtn) return;
        if (!requireConnectAuth()) return;

        detailInterestBtn.disabled = true;
        detailInterestBtn.textContent = 'Saving…';

        const { error } = await supabase.rpc('register_connect_interest', {
          p_note: detailInterestNote?.value ?? '',
          p_service_id: interestServiceId,
        });

        if (error) {
          alert(error.message || 'Could not save. Try again.');
          detailInterestBtn.disabled = false;
          detailInterestBtn.textContent = connectBatchCopy.cta;
          return;
        }

        closeConnectDetail();
        activeHoldSlotId = null;
        if (selectedSlotId) {
          selectedSlotId = null;
          selectedDateKey = null;
          resetBookingBar();
          updateDeckState();
          renderAvailabilityFeed();
        }
        await loadAllSlots();
      }

      function closeConnectDetail() {
        if (!detailRoot) return;
        detailRoot.classList.remove('active');
        detailRoot.setAttribute('aria-hidden', 'true');
        detailRoot.hidden = true;
        document.body.style.overflow = '';
        resetDetailModes();
      }

      detailInterestBtn?.addEventListener('click', () => {
        void submitConnectInterest();
      });

      document.querySelectorAll('[data-connect-id]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-connect-id');
          if (id) handleDeckClick(id, el as HTMLElement);
        });
      });

      detailBackdrop?.addEventListener('click', closeConnectDetail);
      detailClose?.addEventListener('click', closeConnectDetail);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && detailRoot && !detailRoot.hidden) closeConnectDetail();
      });

      function applyConnectAuthNav(signedIn: boolean) {
        syncConnectAuthUi();
        const navAuth = document.getElementById('connect-nav-auth');

        if (signedIn) {
          if (navAuth) {
            navAuth.textContent = 'Sign out';
            navAuth.href = '#';
            navAuth.setAttribute('aria-label', 'Sign out of your account');
            if (!navAuth.dataset.bound) {
              navAuth.dataset.bound = '1';
              navAuth.addEventListener('click', async (e) => {
                e.preventDefault();
                await supabase.auth.signOut();
                window.location.href = '/login?redirect=/connect';
              });
            }
          }
        } else {
          if (navAuth) {
            navAuth.textContent = 'Sign in';
            navAuth.href = '/login?redirect=/connect';
            navAuth.setAttribute('aria-label', 'Sign in');
          }
        }
      }

      const { data: { session } } = await supabase.auth.getSession();
      authSession = session;
      applyConnectAuthNav(!!session);

      if (session) {
        setAdminNavLink(availLink, await fetchIsAdmin());
      } else {
        setAdminNavLink(availLink, false);
      }

      await loadAllSlots();

      supabase.auth.onAuthStateChange(async (_event, nextSession) => {
        authSession = nextSession;
        applyConnectAuthNav(!!nextSession);
        if (nextSession) {
          setAdminNavLink(availLink, await fetchIsAdmin());
        } else {
          setAdminNavLink(availLink, false);
        }
        await loadAllSlots();
      });

      const themeBtn = document.getElementById('connect-theme');
      themeBtn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
      });
    </script>
  </body>
</html>
