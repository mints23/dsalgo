---
import '../styles/global.css';
import '../styles/connect-client.css';
import LogoMark from '../components/LogoMark.astro';
import {
  SUPPORT_EMAIL,
  SESSION_FOOTNOTE,
  urgentService,
  connectServices as services,
  connectOfferings,
  introBody,
  mailtoLink,
  connectSessionPricePaise,
  isConnectSlotBookable,
  connectBatchCopy,
} from '../data/connect-services';

const sessionFootnote = SESSION_FOOTNOTE;
const mailto = mailtoLink;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connect — 1:1 Mentoring · algofrog.in</title>
    <meta
      name="description"
      content="Personal mentoring for high-CTC prep — system design, roadmaps, CV review, DSA classes, 1:1 mentorship, and motivation. From the team behind DSA Mastery."
    />
    <meta name="theme-color" content="#1f5c61" />
    <link rel="canonical" href="https://algofrog.in/connect" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Inter:wght@300..700&display=swap"
      rel="stylesheet"
    />
    <style>
      .connect-page {
        --connect-glow: color-mix(in oklab, var(--primary) 22%, transparent);
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        padding: clamp(1rem, 3vw, 2rem);
        position: relative;
        overflow-x: hidden;
        background:
          radial-gradient(ellipse 90% 55% at 50% -8%, var(--connect-glow), transparent 62%),
          radial-gradient(ellipse 50% 40% at 100% 50%, color-mix(in oklab, #6d28d9 8%, transparent), transparent),
          radial-gradient(ellipse 45% 35% at 0% 80%, color-mix(in oklab, var(--primary) 10%, transparent), transparent),
          var(--bg);
      }
      .connect-page::before {
        content: '';
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.35;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
        z-index: 0;
      }
      [data-theme='dark'] .connect-page::before {
        opacity: 0.2;
      }
      .connect-shell {
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
      }
      .connect-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: clamp(1.25rem, 3vh, 2rem);
      }
      .connect-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        text-decoration: none;
        color: var(--text);
      }
      .connect-brand-text {
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1.2;
      }
      .connect-brand-sub {
        font-size: 0.68rem;
        color: var(--muted);
        font-weight: 500;
      }
      .connect-top-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }
      .connect-top-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
        padding: 0.38rem 0.85rem;
        border-radius: 999px;
        border: 1px solid color-mix(in oklab, var(--border) 70%, var(--primary));
        background: color-mix(in oklab, var(--surface) 88%, var(--bg));
        white-space: nowrap;
        transition:
          color 0.15s,
          background 0.15s,
          border-color 0.15s,
          box-shadow 0.15s,
          transform 0.15s;
      }
      .connect-top-link:hover {
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 10%, var(--surface));
        border-color: color-mix(in oklab, var(--primary) 35%, var(--border));
      }
      .connect-pill--primary {
        color: #fff;
        font-weight: 700;
        border-color: color-mix(in oklab, var(--primary) 55%, #0a5c62);
        background: linear-gradient(
          128deg,
          color-mix(in oklab, var(--primary) 88%, #fff) 0%,
          var(--primary) 48%,
          color-mix(in oklab, var(--primary) 78%, #0a3d42) 100%
        );
        box-shadow:
          inset 0 1px 0 color-mix(in srgb, #fff 22%, transparent),
          0 2px 10px color-mix(in oklab, var(--primary) 35%, transparent);
      }
      .connect-pill--primary:hover {
        color: #fff;
        transform: translateY(-1px);
        background: linear-gradient(
          128deg,
          color-mix(in oklab, var(--primary) 75%, #fff) 0%,
          color-mix(in oklab, var(--primary) 95%, #02b8b0) 50%,
          color-mix(in oklab, var(--primary) 70%, #065a60) 100%
        );
        border-color: color-mix(in oklab, var(--primary) 65%, #f0c96a);
        box-shadow:
          inset 0 1px 0 color-mix(in srgb, #fff 28%, transparent),
          0 4px 16px color-mix(in oklab, var(--primary) 42%, transparent);
      }
      .connect-top-link:focus-visible,
      .connect-pill:focus-visible {
        outline: 2px solid color-mix(in oklab, var(--primary) 50%, transparent);
        outline-offset: 2px;
      }
      .connect-theme-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface);
        color: var(--muted);
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
      }
      .connect-theme-btn:hover {
        color: var(--primary);
        border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      }

      /* Calendar + services booking */
      .connect-book-row {
        display: grid;
        grid-template-columns: minmax(16rem, 24rem) minmax(0, 1fr);
        gap: 1.25rem;
        align-items: start;
        margin-bottom: 1.75rem;
      }
      .connect-book {
        margin-bottom: 0;
        min-width: 0;
      }
      .connect-slots-panel {
        position: relative;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        box-shadow: var(--shadow);
        padding: 0.85rem 0.75rem 0.75rem;
      }
      .connect-slots-panel::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(
          90deg,
          var(--primary) 0%,
          color-mix(in oklab, var(--primary) 55%, #6d28d9) 100%
        );
      }
      .connect-slots-panel--pulse {
        animation: connect-slots-pulse 0.85s ease-out;
      }
      @keyframes connect-slots-pulse {
        0%,
        100% {
          box-shadow: var(--shadow);
        }
        35%,
        65% {
          box-shadow:
            0 0 0 2px color-mix(in oklab, var(--primary) 45%, transparent),
            0 12px 28px color-mix(in oklab, var(--primary) 22%, transparent);
        }
      }
      .connect-slots-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
        padding-bottom: 0.55rem;
        border-bottom: 1px solid var(--divider);
      }
      .connect-slots-title {
        margin: 0;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--faint);
      }
      .connect-slots-signin-hint {
        margin: 0 0 0.65rem;
        padding: 0.5rem 0.65rem;
        font-size: 0.76rem;
        font-weight: 600;
        line-height: 1.45;
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 8%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--primary) 24%, var(--border));
        border-radius: 0.55rem;
      }
      .connect-slots-signin-hint a {
        color: inherit;
        font-weight: 700;
      }
      .connect-my-bookings {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
      }
      .connect-slots-badge {
        font-size: 0.58rem;
        font-weight: 700;
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 10%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--primary) 22%, var(--border));
        padding: 0.14rem 0.45rem;
        border-radius: 999px;
        white-space: nowrap;
      }
      .connect-avail-feed {
        width: 100%;
        min-height: min(20rem, 54vh);
        max-height: min(30rem, 68vh);
        overflow: auto;
        padding-right: 0.15rem;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in oklab, var(--primary) 35%, var(--border)) transparent;
      }
      .connect-avail-feed::-webkit-scrollbar {
        width: 5px;
      }
      .connect-avail-feed::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: color-mix(in oklab, var(--primary) 35%, var(--border));
      }
      .connect-service-row:hover {
        border-color: color-mix(in oklab, var(--row-accent) 45%, var(--border));
      }
      .connect-service-row--selected {
        box-shadow: 0 0 0 2px color-mix(in oklab, var(--row-accent) 35%, transparent);
      }
      .connect-service-meta {
        font-size: 0.72rem;
        color: var(--muted);
        margin-top: 0.35rem;
        line-height: 1.45;
      }
      .connect-panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        box-shadow: var(--shadow);
        padding: 1rem;
      }
      .connect-panel-title {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--faint);
        margin-bottom: 0.75rem;
      }
      .connect-cal-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.65rem;
      }
      .connect-cal-nav-btn {
        width: 1.85rem;
        height: 1.85rem;
        border: 1px solid var(--border);
        border-radius: 0.4rem;
        background: var(--surface2);
        color: var(--muted);
        cursor: pointer;
        font-size: 1rem;
        line-height: 1;
      }
      .connect-cal-nav-btn:hover {
        color: var(--primary);
        border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
      }
      .connect-cal-label {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--text);
      }
      .connect-cal-weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.15rem;
        margin-bottom: 0.35rem;
      }
      .connect-cal-weekdays span {
        text-align: center;
        font-size: 0.62rem;
        font-weight: 700;
        color: var(--faint);
        text-transform: uppercase;
      }
      .connect-cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 0.2rem;
      }
      .connect-cal-day {
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        border: 1px solid transparent;
        border-radius: 0.45rem;
        background: transparent;
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 600;
        cursor: default;
        padding: 0;
      }
      .connect-cal-day--empty {
        visibility: hidden;
      }
      .connect-cal-day--has-slots {
        color: var(--text);
        cursor: pointer;
        background: color-mix(in oklab, var(--primary) 8%, var(--surface));
        border-color: color-mix(in oklab, var(--primary) 18%, var(--border));
      }
      .connect-cal-day--has-slots:hover {
        border-color: color-mix(in oklab, var(--primary) 40%, var(--border));
        background: color-mix(in oklab, var(--primary) 14%, var(--surface));
      }
      .connect-cal-day--selected {
        color: var(--inv);
        background: var(--primary);
        border-color: var(--primary);
      }
      .connect-cal-day--selected::after {
        background: var(--inv);
      }
      .connect-cal-day--has-slots::after {
        content: '';
        position: absolute;
        bottom: 0.18rem;
        width: 0.28rem;
        height: 0.28rem;
        border-radius: 50%;
        background: var(--primary);
      }
      .connect-cal-hint {
        margin-top: 0.65rem;
        font-size: 0.68rem;
        line-height: 1.45;
        color: var(--faint);
      }
      .connect-services-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        margin-top: 0.15rem;
      }
      .connect-service-row {
        --row-accent: var(--primary);
        appearance: none;
        width: 100%;
        box-sizing: border-box;
        border: 1px solid color-mix(in oklab, var(--row-accent) 22%, var(--border));
        border-radius: 0.65rem;
        padding: 0.75rem 0.85rem;
        background: color-mix(in oklab, var(--row-accent) 5%, var(--surface));
        text-align: left;
        font: inherit;
        color: inherit;
        cursor: pointer;
        transition: border-color 0.15s, box-shadow 0.15s;
      }
      .connect-service-row-head {
        display: flex;
        align-items: flex-start;
        gap: 0.55rem;
        margin-bottom: 0.55rem;
      }
      .connect-service-row-icon {
        font-size: 1.35rem;
        line-height: 1;
      }
      .connect-service-row-title {
        font-size: 0.92rem;
        font-weight: 800;
        color: var(--text);
        line-height: 1.25;
      }
      .connect-service-row-benefit {
        font-size: 0.68rem;
        font-weight: 700;
        color: var(--row-accent);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      .connect-service-row-price {
        margin-left: auto;
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--row-accent);
        white-space: nowrap;
      }
      .connect-time-chips {
        display: none;
      }
      .connect-other--awaiting-slot .connect-deck .connect-card {
        opacity: 0.5;
        filter: grayscale(0.15);
      }
      .connect-other--awaiting-slot .connect-deck .connect-card--soon {
        opacity: 0.92;
        filter: none;
      }
      .connect-other--slot-selected {
        position: relative;
        padding: 0.85rem 0.75rem 0.75rem;
        border-radius: 0.85rem;
        border: 1px solid color-mix(in oklab, var(--primary) 32%, var(--border));
        background:
          radial-gradient(ellipse 120% 80% at 50% -20%, color-mix(in oklab, var(--primary) 16%, transparent), transparent 55%),
          color-mix(in oklab, var(--primary) 5%, var(--surface));
        box-shadow:
          0 0 0 1px color-mix(in oklab, var(--primary) 12%, transparent),
          0 10px 32px color-mix(in oklab, var(--primary) 18%, transparent);
        animation: connect-deck-unlock 0.55s ease-out;
      }
      .connect-other--slot-selected::before {
        content: '';
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        padding: 1px;
        background: conic-gradient(
          from var(--connect-deck-angle, 0deg),
          transparent 0%,
          color-mix(in oklab, var(--primary) 55%, #6d28d9) 25%,
          color-mix(in oklab, var(--primary) 75%, #02a6a0) 50%,
          color-mix(in oklab, #6d28d9 50%, var(--primary)) 75%,
          transparent 100%
        );
        -webkit-mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask:
          linear-gradient(#fff 0 0) content-box,
          linear-gradient(#fff 0 0);
        mask-composite: exclude;
        opacity: 0.75;
        pointer-events: none;
        animation: connect-deck-border-spin 5s linear infinite;
      }
      @keyframes connect-deck-border-spin {
        to {
          --connect-deck-angle: 360deg;
        }
      }
      @property --connect-deck-angle {
        syntax: '<angle>';
        initial-value: 0deg;
        inherits: false;
      }
      @keyframes connect-deck-unlock {
        from {
          opacity: 0.65;
          transform: translateY(6px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .connect-other--slot-selected .connect-deck-label {
        color: var(--primary);
        text-shadow: 0 0 18px color-mix(in oklab, var(--primary) 35%, transparent);
        animation: connect-deck-label-pop 0.5s ease-out;
      }
      @keyframes connect-deck-label-pop {
        0% {
          transform: scale(0.96);
          opacity: 0.5;
        }
        60% {
          transform: scale(1.03);
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }
      .connect-other--slot-selected .connect-deck .connect-card {
        opacity: 1;
        filter: none;
        animation: connect-card-pop 0.45s ease-out backwards;
        animation-delay: calc(var(--i, 0) * 0.045s);
      }
      @keyframes connect-card-pop {
        from {
          opacity: 0.4;
          transform: translateY(8px) scale(0.96);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }
      .connect-other--slot-selected .connect-deck .connect-card:hover {
        border-color: color-mix(in srgb, var(--card-accent) 45%, var(--border));
        transform: translateY(-3px);
        box-shadow: 0 8px 22px color-mix(in oklab, var(--card-accent) 22%, transparent);
      }
      .connect-other--slot-selected .connect-deck .connect-card--soon {
        animation: connect-card-pop 0.45s ease-out backwards;
        animation-delay: calc(var(--i, 0) * 0.045s);
      }
      .connect-card--service-picked {
        outline: 2px solid var(--card-accent);
        outline-offset: 2px;
      }
      .connect-card--soon {
        cursor: pointer;
      }
      .connect-card--soon .connect-card-hint {
        font-size: 0.62rem;
        line-height: 1.35;
      }
      .connect-soon-badge {
        position: absolute;
        top: 0.42rem;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2;
        padding: 0.14rem 0.45rem;
        border-radius: 999px;
        font-size: 0.5rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #5b21b6;
        background: color-mix(in oklab, #6d28d9 14%, #fff);
        border: 1px solid color-mix(in oklab, #6d28d9 28%, transparent);
        box-shadow: 0 2px 8px color-mix(in oklab, #6d28d9 18%, transparent);
      }
      [data-theme='dark'] .connect-soon-badge {
        color: #ddd6fe;
        background: color-mix(in oklab, #6d28d9 22%, var(--surface));
      }
      .connect-card--soon .connect-card-cta {
        color: #6d28d9;
      }
      [data-theme='dark'] .connect-card--soon .connect-card-cta {
        color: #c4b5fd;
      }
      .connect-other--service-picked .connect-deck .connect-card:not(.connect-card--service-picked) {
        opacity: 0.72;
      }
      .connect-other--service-picked .connect-deck .connect-card:not(.connect-card--service-picked):hover {
        opacity: 1;
      }
      .connect-other--service-picked .connect-deck .connect-card--service-picked {
        opacity: 1;
      }
      .connect-booking-bar-note {
        font-size: 0.68rem;
        color: var(--muted);
        margin-top: 0.35rem;
      }
      .connect-booking-bar {
        margin-top: 1rem;
        padding: 0.75rem 0.85rem;
        border-radius: 0.65rem;
        border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--border));
        background: color-mix(in oklab, var(--primary) 8%, var(--surface));
      }
      .connect-booking-bar p {
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--text);
        margin-bottom: 0.65rem;
      }
      .connect-other {
        margin-bottom: 0;
        min-width: 0;
      }

      /* Deck */
      .connect-deck-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--faint);
        margin-bottom: 0.65rem;
        text-align: left;
      }
      .connect-deck-slot-hint {
        margin: -0.35rem 0 0.65rem;
        padding: 0.55rem 0.65rem;
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.45;
        color: var(--primary);
        background: color-mix(in oklab, var(--primary) 8%, var(--surface));
        border: 1px solid color-mix(in oklab, var(--primary) 28%, var(--border));
        border-radius: 0.55rem;
      }
      .connect-deck-slot-hint--flash {
        animation: connect-deck-hint-flash 0.6s ease-out;
      }
      @keyframes connect-deck-hint-flash {
        0% {
          transform: scale(0.98);
          opacity: 0.6;
        }
        100% {
          transform: scale(1);
          opacity: 1;
        }
      }
      .connect-deck-layout {
        display: grid;
        grid-template-columns: 1fr minmax(7rem, 9.25rem);
        gap: 0.75rem;
        align-items: center;
        margin-bottom: 1.75rem;
      }
      .connect-urgent-glow {
        position: relative;
        width: 100%;
        border-radius: 0.88rem;
        isolation: isolate;
      }
      .connect-urgent-glow::before,
      .connect-urgent-glow::after {
        content: '';
        position: absolute;
        border-radius: inherit;
        pointer-events: none;
        animation: connect-urgent-spin 7s linear infinite;
      }
      .connect-urgent-glow::before {
        inset: -3px;
        background: conic-gradient(
          from 0deg,
          transparent 0%,
