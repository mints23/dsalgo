        .connect-deck {
          gap: 0.5rem;
        }
        .connect-card {
          padding: 0.65rem 0.45rem;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .connect-other--slot-selected,
        .connect-other--slot-selected::before,
        .connect-other--slot-selected .connect-deck-label,
        .connect-other--slot-selected .connect-deck .connect-card {
          animation: none;
        }
        .connect-other--slot-selected .connect-deck .connect-card:hover {
          transform: none;
        }
        .connect-card,
        .connect-card--urgent,
        .connect-cta {
          animation: none;
        }
        .connect-urgent-glow::before,
        .connect-urgent-glow::after {
          animation: none;
        }
        .connect-card:hover,
        .connect-card--urgent:hover {
          transform: none;
        }
      }
    </style>
  </head>
  <body>
    <div class="connect-page">
      <div class="connect-shell">
        <header class="connect-top">
          <a class="connect-brand" href="/">
            <LogoMark width={28} height={28} />
            <div>
              <div class="connect-brand-text">DSA Mastery</div>
              <div class="connect-brand-sub">algofrog.in</div>
            </div>
          </a>
          <div class="connect-top-actions">
            <a class="connect-top-link connect-pill connect-pill--primary" href="/">Back to DSA sheet</a>
            <a class="connect-top-link connect-pill" href="/admin" id="connect-avail-link" hidden>Admin</a>
            <a class="connect-top-link connect-pill" href="/login?redirect=/connect" id="connect-nav-auth">Sign in</a>
            <button class="connect-theme-btn" id="connect-theme" type="button" aria-label="Toggle theme">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
              </svg>
            </button>
          </div>
        </header>

        <main>
          <div class="connect-book-row">
            <section class="connect-book connect-slots-panel" aria-label="Book a live session">
              <div class="connect-slots-head">
                <p class="connect-slots-title">Pick a time</p>
                <span class="connect-slots-badge" id="connect-slots-count" hidden></span>
              </div>
              <p class="connect-slots-signin-hint" id="connect-slots-signin-hint" hidden>
                <a href="/login?redirect=/connect">Sign in</a> to pick a slot and book a session.
              </p>
              <div id="connect-my-bookings" class="connect-my-bookings" hidden aria-label="Your booked sessions"></div>
              <div class="connect-avail-feed" id="connect-avail-feed" aria-label="Date and time slots"></div>
            </section>

            <section class="connect-other connect-other--awaiting-slot" id="connect-service-deck" aria-label="Choose your service">
              <p class="connect-deck-label">Choose your service</p>
              <p class="connect-deck-slot-hint" id="connect-deck-slot-hint" hidden role="status" aria-live="polite">
                Pick a time slot on the left before choosing a service.
              </p>
            <div class="connect-deck-layout">
              <div class="connect-deck" role="list">
                {
                  services.map((s, i) => (
                    <button
                      type="button"
                      class:list={['connect-card', s.comingSoon && 'connect-card--soon']}
                      role="listitem"
                      style={`--card-accent: ${s.accent}; --i: ${i}`}
                      data-connect-id={s.id}
                      data-connect-bookable={isConnectSlotBookable(s) ? '1' : '0'}
                      data-connect-coming-soon={s.comingSoon ? '1' : '0'}
                      title={s.comingSoon ? `${s.title} — ${connectBatchCopy.cardHint}` : s.hook}
                    >
                      {s.comingSoon && <span class="connect-soon-badge">{connectBatchCopy.badge}</span>}
                      <span class="connect-card-icon" aria-hidden="true">{s.icon}</span>
                      <span class="connect-card-benefit">{s.benefit}</span>
                      <span class="connect-card-title">{s.title}</span>
                      <span class="connect-card-hint">{s.hook}</span>
                      <span class="connect-card-cta">{s.comingSoon ? connectBatchCopy.cta : 'Book this →'}</span>
                    </button>
                  ))
                }
              </div>
            <div class="connect-urgent-glow">
              <button
                type="button"
                class="connect-card connect-card--urgent"
                role="listitem"
                style={`--card-accent: ${urgentService.accent}; --i: 6`}
                data-connect-id={urgentService.id}
                title={urgentService.hook}
              >
                <span class="connect-urgent-badge">Urgent</span>
                <span class="connect-card-icon" aria-hidden="true">{urgentService.icon}</span>
                <span class="connect-card-benefit">{urgentService.benefit}</span>
                <span class="connect-card-title">{urgentService.title}</span>
                <span class="connect-card-price">
                  <span class="connect-card-price-amt">{urgentService.price}</span>
                  <span class="connect-card-price-period">{urgentService.pricePeriod}</span>
                </span>
                <span class="connect-card-cta">View details →</span>
              </button>
            </div>
          </div>
            <div class="connect-booking-bar" id="connect-booking-bar" hidden>
              <p id="connect-booking-msg"></p>
              <p class="connect-booking-bar-note" id="connect-booking-note" hidden>
                Tap another service above to change before you pay. When you pay, the slot is held for 7 minutes.
              </p>
              <button type="button" class="connect-cta-btn" id="connect-booking-pay" hidden>Pay to confirm →</button>
            </div>
          </section>
          </div>

          <section class="connect-cta">
            <h2 class="connect-cta-headline">Not sure where to start?</h2>
            <p class="connect-cta-text">
              Send one email with your target CTC, current level, and biggest blocker. I’ll point you to the right service — no pressure, no spam.
            </p>
            <a
              class="connect-cta-btn"
              href={mailto('Connect — Intro call', introBody)}
            >
              Start with a free intro email
              <span aria-hidden="true">→</span>
            </a>
            <p class="connect-cta-sub">
              Or write directly: <a class="connect-email-link" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>
            </p>
          </section>

          <nav class="connect-footer" aria-label="Site links">
            <a class="connect-pill connect-pill--primary" href="/">Back to DSA sheet</a>
            <a class="connect-pill" href="/login?redirect=/connect" id="connect-footer-auth">Sign in</a>
          </nav>
          <p class="connect-footnote">
            <span class="connect-footnote-star" aria-hidden="true">*</span>
            {sessionFootnote}
          </p>
        </main>
      </div>
    </div>

    <div
      id="connect-detail"
      class="connect-detail"
      role="dialog"
      aria-modal="true"
      aria-labelledby="connect-detail-title"
      aria-hidden="true"
      hidden
    >
      <button type="button" class="connect-detail-backdrop" id="connect-detail-backdrop" aria-label="Close details"></button>
      <div class="connect-detail-panel">
        <button type="button" class="connect-detail-close" id="connect-detail-close" aria-label="Close">✕</button>
        <div class="connect-detail-icon" id="connect-detail-icon" aria-hidden="true"></div>
        <p class="connect-detail-benefit" id="connect-detail-benefit"></p>
        <h2 class="connect-detail-title" id="connect-detail-title"></h2>
        <p class="connect-detail-hook" id="connect-detail-hook"></p>
        <span class="connect-detail-soon-badge" id="connect-detail-soon-badge" hidden>{connectBatchCopy.badge}</span>
        <div class="connect-detail-price" id="connect-detail-price-wrap">
          <span class="connect-detail-price-amt" id="connect-detail-price-amt"></span>
          <span class="connect-detail-price-period" id="connect-detail-price-period"></span>
        </div>
        <div class="connect-detail-interest" id="connect-detail-interest" hidden>
          <p class="connect-detail-interest-lead" id="connect-detail-interest-lead">
            {connectBatchCopy.modalLead}
          </p>
          <label class="connect-detail-interest-label" for="connect-detail-interest-note">
            Your level & topics (optional)
          </label>
          <textarea
            class="connect-detail-interest-note"
            id="connect-detail-interest-note"
            rows="3"
            maxlength="500"
            placeholder="e.g. Student · trees, graphs, DP · targeting SDE-2 in 6 months"
          ></textarea>
          <p class="connect-detail-interest-status" id="connect-detail-interest-status" hidden role="status"></p>
          <button type="button" class="connect-cta-btn connect-detail-interest-btn" id="connect-detail-interest-btn">
            {connectBatchCopy.cta}
          </button>
        </div>
        <p class="connect-detail-note" id="connect-detail-footnote">{sessionFootnote}</p>
        <div class="connect-detail-slots" id="connect-detail-slots" hidden>
          <p class="connect-detail-slots-label">Pick a session time</p>
          <div class="connect-slot-list" id="connect-slot-list"></div>
          <div class="connect-slot-reserved" id="connect-slot-reserved" hidden></div>
          <button type="button" class="connect-cta-btn connect-detail-book" id="connect-detail-pay" hidden>
            Pay to confirm →
          </button>
        </div>
        <a class="connect-cta-btn connect-detail-book" id="connect-detail-book" href="#">Book via email →</a>
      </div>
    </div>

    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script id="connect-offerings-data" type="application/json" set:html={JSON.stringify(connectOfferings)} />

    <script>
      import { supabase } from '../lib/supabase';
      import type { ConnectService } from '../data/connect-services';
      import { connectSessionPricePaise, connectBatchCopy } from '../data/connect-services';
      import { loadConnectSlots, loadMyConnectBookings, type ConnectSlot } from '../lib/connect-slots';
      import { fetchIsAdmin, setAdminNavLink } from '../lib/admin-access';
      import { connectPaymentNotes, waitForConnectPaid } from '../lib/payment-await';

      const IST = 'Asia/Kolkata';
      const dateFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        weekday: 'short',
        day: 'numeric',
        month: 'short',
      });
      const timeFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      });
      const dayMonthFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        day: 'numeric',
        month: 'short',
      });
      const weekdayFmt = new Intl.DateTimeFormat('en-IN', {
        timeZone: IST,
        weekday: 'short',
      });

      const SLOT_COLUMNS = 3;

      type SlotRow = ConnectSlot;

      const offeringsEl = document.getElementById('connect-offerings-data');
      const offerings: ConnectService[] = offeringsEl?.textContent
        ? JSON.parse(offeringsEl.textContent)
        : [];
      const availFeed = document.getElementById('connect-avail-feed');
      const myBookingsPanel = document.getElementById('connect-my-bookings');
      const slotsCountBadge = document.getElementById('connect-slots-count');
      const serviceDeck = document.getElementById('connect-service-deck');
      const bookingBar = document.getElementById('connect-booking-bar');
      const bookingMsg = document.getElementById('connect-booking-msg');
      const bookingNote = document.getElementById('connect-booking-note');
      const bookingPay = document.getElementById('connect-booking-pay') as HTMLButtonElement | null;
      const deckSlotHint = document.getElementById('connect-deck-slot-hint');
      const slotsSignInHint = document.getElementById('connect-slots-signin-hint');
      const slotsPanel = document.querySelector('.connect-slots-panel');

      const detailRoot = document.getElementById('connect-detail');
      const detailBackdrop = document.getElementById('connect-detail-backdrop');
      const detailClose = document.getElementById('connect-detail-close');
      const detailBook = document.getElementById('connect-detail-book') as HTMLAnchorElement | null;
      const detailSoonBadge = document.getElementById('connect-detail-soon-badge');
      const detailPriceWrap = document.getElementById('connect-detail-price-wrap');
      const detailInterest = document.getElementById('connect-detail-interest');
      const detailInterestNote = document.getElementById('connect-detail-interest-note') as HTMLTextAreaElement | null;
      const detailInterestStatus = document.getElementById('connect-detail-interest-status');
      const detailInterestBtn = document.getElementById('connect-detail-interest-btn') as HTMLButtonElement | null;
      const detailFootnote = document.getElementById('connect-detail-footnote');
      const availLink = document.getElementById('connect-avail-link');

      let authSession: Awaited<ReturnType<typeof supabase.auth.getSession>>['data']['session'] = null;
      let interestServiceId: string | null = null;
      let activeOffering: ConnectService | null = null;
      let reservedSlot: SlotRow | null = null;
      let allSlots: SlotRow[] = [];
      let myBookings: SlotRow[] = [];
      let selectedDateKey: string | null = null;
      let selectedSlotId: number | null = null;
      let activeHoldSlotId: number | null = null;

      const dayKeyFmt = new Intl.DateTimeFormat('en-CA', { timeZone: IST });

      function istDateKey(iso: string) {
        return dayKeyFmt.format(new Date(iso));
      }

      function todayKey() {
        return dayKeyFmt.format(new Date());
      }

      function requireConnectAuth(): boolean {
        if (authSession) return true;
        window.location.href = '/login?redirect=/connect';
        return false;
      }

      function syncConnectAuthUi() {
        if (slotsSignInHint) slotsSignInHint.hidden = !!authSession;
      }

      function mailtoLink(subject: string, body: string) {
        const params = new URLSearchParams();
        params.set('subject', subject);
        params.set('body', body);
        return `mailto:algofrog07@gmail.com?${params.toString()}`;
      }

      async function releaseActiveHold() {
        if (activeHoldSlotId == null) return;
        const slotId = activeHoldSlotId;
        activeHoldSlotId = null;
        const { error } = await supabase.rpc('release_my_connect_slot_hold', { p_slot_id: slotId });
        if (error) console.error('Failed to release slot hold:', error);
      }

      function resetBookingBar() {
        reservedSlot = null;
        activeOffering = null;
        if (bookingBar) bookingBar.hidden = true;
        if (bookingPay) bookingPay.hidden = true;
        if (bookingNote) bookingNote.hidden = true;
        if (bookingMsg) bookingMsg.textContent = '';
        syncServicePickHighlight();
      }

      function syncServicePickHighlight() {
        serviceDeck?.classList.toggle(
          'connect-other--service-picked',
          !!selectedSlotId && !!activeOffering,
        );
        document.querySelectorAll('.connect-deck .connect-card[data-connect-id]').forEach((el) => {
          const id = el.getAttribute('data-connect-id');
          if (el.getAttribute('data-connect-coming-soon') === '1') {
            el.classList.remove('connect-card--service-picked');
            el.setAttribute('aria-pressed', 'false');
            return;
          }
          el.classList.toggle('connect-card--service-picked', !!activeOffering && id === activeOffering.id);
          el.setAttribute('aria-pressed', !!activeOffering && id === activeOffering.id ? 'true' : 'false');
        });
      }

      async function clearTimeSelection() {
        await releaseActiveHold();
        selectedSlotId = null;
        selectedDateKey = null;
        resetBookingBar();
        updateDeckState();
        await loadAllSlots();
      }

      function updateDeckState() {
        serviceDeck?.classList.toggle('connect-other--awaiting-slot', !selectedSlotId);
        serviceDeck?.classList.toggle('connect-other--slot-selected', !!selectedSlotId);
        if (deckSlotHint && selectedSlotId) deckSlotHint.hidden = true;
        document.querySelectorAll('.connect-deck .connect-card[data-connect-id]').forEach((card) => {
          const cta = card.querySelector('.connect-card-cta');
          if (!cta) return;
          if (card.getAttribute('data-connect-coming-soon') === '1') {
            cta.textContent = connectBatchCopy.cta;
            return;
          }
          cta.textContent = selectedSlotId ? 'Book this →' : 'Pick a time first →';
        });
        syncServicePickHighlight();
      }

      function promptPickSlotFirst() {
        if (deckSlotHint) {
          deckSlotHint.hidden = false;
          deckSlotHint.classList.remove('connect-deck-slot-hint--flash');
          void deckSlotHint.offsetWidth;
          deckSlotHint.classList.add('connect-deck-slot-hint--flash');
        }
        slotsPanel?.classList.remove('connect-slots-panel--pulse');
        void (slotsPanel as HTMLElement | null)?.offsetWidth;
        slotsPanel?.classList.add('connect-slots-panel--pulse');
        slotsPanel?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        window.setTimeout(() => {
          slotsPanel?.classList.remove('connect-slots-panel--pulse');
          deckSlotHint?.classList.remove('connect-deck-slot-hint--flash');
        }, 900);
      }

      function serviceTitle(serviceId: string) {
        return offerings.find((o) => o.id === serviceId)?.title ?? serviceId;
      }

      function formatBookingWhen(startsAt: string) {
        const d = new Date(startsAt);
        const date = `${weekdayFmt.format(d)}, ${dayMonthFmt.format(d)}`;
        const time = timeFmt.format(d);
        return { date, time, full: `${date} · ${time}` };
      }

      function buildMyBookingRow(slot: SlotRow) {
        const when = formatBookingWhen(slot.starts_at);
        const row = document.createElement('div');
        row.className = 'connect-my-bookings-row';

        const main = document.createElement('div');
        main.className = 'connect-my-bookings-main';

        const service = document.createElement('strong');
        service.className = 'connect-my-bookings-service';
        service.textContent = serviceTitle(slot.service_id);

        const whenEl = document.createElement('span');
        whenEl.className = 'connect-my-bookings-when';
        whenEl.textContent = when.full;

        main.appendChild(service);
        main.appendChild(whenEl);

        const status = document.createElement('span');
        status.className = 'connect-my-bookings-status';
        status.textContent = 'Booked';

        row.appendChild(main);
        row.appendChild(status);
        row.title = `${serviceTitle(slot.service_id)} — ${when.full} (confirmed)`;
        return row;
      }

      function buildBookedPill(slot: SlotRow) {
        const span = document.createElement('span');
        const held = slot.status === 'reserved';
        span.className =
          'connect-slot-pill connect-slot-pill--booked' + (held ? ' connect-slot-pill--held' : '');
        const when = timeFmt.format(new Date(slot.starts_at));
        span.textContent = held ? `${when} · hold` : `${when} · booked`;
        span.title = held
          ? `${serviceTitle(slot.service_id)} · checkout hold`
          : `${serviceTitle(slot.service_id)} · your confirmed session`;
        return span;
      }

      function buildSlotButton(slot: SlotRow) {
        const selected = slot.id === selectedSlotId;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'connect-slot-pill connect-time-slot-btn';
        if (selected) {
          btn.classList.add('connect-slot-pill--selected', 'connect-time-slot-btn--selected');
        }
        btn.textContent = timeFmt.format(new Date(slot.starts_at));
        btn.setAttribute('data-slot-id', String(slot.id));
        btn.setAttribute('aria-pressed', selected ? 'true' : 'false');
        btn.setAttribute(
          'aria-label',
          `${dayMonthFmt.format(new Date(slot.starts_at))} at ${timeFmt.format(new Date(slot.starts_at))}`,
        );
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          selectTimeSlot(slot);
        });
        return btn;
      }

      type FeedCell = { slot: SlotRow; kind: 'open' | 'mine' };

      function renderMyBookingsPanel() {
        if (!myBookingsPanel) return;
        const paid = myBookings.filter((b) => b.status === 'paid');
        if (!paid.length) {
          myBookingsPanel.hidden = true;
          myBookingsPanel.innerHTML = '';
          return;
        }

        myBookingsPanel.hidden = false;
        const heading =
          paid.length === 1 ? 'Your upcoming session' : `Your upcoming sessions (${paid.length})`;
        myBookingsPanel.innerHTML = `<p class="connect-my-bookings-label">${heading}</p>`;
        for (const slot of paid) {
          myBookingsPanel.appendChild(buildMyBookingRow(slot));
        }
      }

      function renderAvailabilityFeed() {
        if (!availFeed) return;

        renderMyBookingsPanel();

        const byDate = new Map<string, FeedCell[]>();
        const seenIds = new Set<number>();

        for (const slot of allSlots) {
          const key = istDateKey(slot.starts_at);
          const list = byDate.get(key) ?? [];
          list.push({ slot, kind: 'open' });
          seenIds.add(slot.id);
          byDate.set(key, list);
        }

        for (const slot of myBookings) {
          if (seenIds.has(slot.id)) continue;
          const key = istDateKey(slot.starts_at);
          const list = byDate.get(key) ?? [];
          list.push({ slot, kind: 'mine' });
          byDate.set(key, list);
        }

        const paidCount = myBookings.filter((b) => b.status === 'paid').length;

        if (!byDate.size && !paidCount) {
          availFeed.innerHTML = '<p class="connect-avail-empty">No open slots right now. Check back soon.</p>';
          if (slotsCountBadge) slotsCountBadge.hidden = true;
          return;
        }

        if (!byDate.size) {
          availFeed.innerHTML =
            '<p class="connect-avail-empty">No other open slots right now. Your session is listed above.</p>';
          if (slotsCountBadge) {
            slotsCountBadge.hidden = false;
            slotsCountBadge.textContent = `${paidCount} booked`;
          }
          return;
        }

        if (slotsCountBadge) {
          slotsCountBadge.hidden = false;
          const parts: string[] = [];
          if (paidCount) parts.push(`${paidCount} booked`);
          if (allSlots.length) parts.push(`${allSlots.length} open`);
          slotsCountBadge.textContent = parts.join(' · ') || 'Your booking';
        }

        const rows = [...byDate.entries()].sort(([a], [b]) => a.localeCompare(b));
        for (const [, cells] of rows) {
          cells.sort((a, b) => {
            if (a.kind !== b.kind) return a.kind === 'mine' ? -1 : 1;
            return a.slot.starts_at.localeCompare(b.slot.starts_at);
          });
        }

        const bookingFirstRows = rows.filter(([, cells]) => cells.some((c) => c.kind === 'mine'));
        const openOnlyRows = rows.filter(([, cells]) => !cells.some((c) => c.kind === 'mine'));
        const orderedRows = [...bookingFirstRows, ...openOnlyRows];

        const today = todayKey();

        const table = document.createElement('table');
        table.className = 'connect-avail-table';
        table.setAttribute('role', 'grid');
        table.setAttribute('aria-label', 'Available session times and your bookings');

        const thead = document.createElement('thead');
        const headRow = document.createElement('tr');
        headRow.innerHTML = '<th>Date</th><th>Slot 1</th><th>Slot 2</th><th>Slot 3</th>';
        thead.appendChild(headRow);
        table.appendChild(thead);

        const tbody = document.createElement('tbody');
        for (const [dateKey, cells] of orderedRows) {
          const tr = document.createElement('tr');
          if (dateKey === today) tr.classList.add('connect-avail-row--today');
          const hasMine = cells.some((c) => c.kind === 'mine');
          if (hasMine) tr.classList.add('connect-avail-row--mine');

          const dateTd = document.createElement('td');
          const dateCell = document.createElement('div');
          dateCell.className = 'connect-avail-date-cell';

          const wd = document.createElement('span');
          wd.className = 'connect-avail-day-wd';
          wd.textContent = weekdayFmt.format(new Date(cells[0].slot.starts_at));

          const dm = document.createElement('span');
          dm.className = 'connect-avail-day-dm';
          dm.textContent = dayMonthFmt.format(new Date(cells[0].slot.starts_at));

          dateCell.appendChild(wd);
          dateCell.appendChild(dm);
          dateTd.appendChild(dateCell);
          tr.appendChild(dateTd);

          for (let i = 0; i < SLOT_COLUMNS; i++) {
            const td = document.createElement('td');
            td.className = 'connect-avail-slot-cell';
            td.setAttribute('role', 'gridcell');
            const cell = cells[i];
            if (cell) {
              td.appendChild(cell.kind === 'open' ? buildSlotButton(cell.slot) : buildBookedPill(cell.slot));
            } else {
              td.classList.add('connect-avail-slot-cell--empty');
              td.textContent = '—';
            }
            tr.appendChild(td);
          }

          tbody.appendChild(tr);
        }
        table.appendChild(tbody);

        availFeed.innerHTML = '';
        availFeed.appendChild(table);
      }

      function selectTimeSlot(slot: SlotRow) {
        if (selectedSlotId === slot.id) {
          void clearTimeSelection();
          return;
        }
        if (!requireConnectAuth()) return;

        selectedSlotId = slot.id;
        selectedDateKey = istDateKey(slot.starts_at);
        resetBookingBar();
        renderAvailabilityFeed();
        updateDeckState();
      }

      function pickServiceForSlot(svc: ConnectService) {
        if (svc.comingSoon) return;
        if (!requireConnectAuth()) return;

        const slot = allSlots.find((s) => s.id === selectedSlotId);
        if (!slot) return;

        reservedSlot = slot;
        activeOffering = svc;
        showBookingBar();
      }

      function handleDeckClick(id: string, _el: HTMLElement) {
        if (id === 'urgent') {
          openConnectDetail(id);
          return;
        }

        const svc = offerings.find((o) => o.id === id);
        if (svc?.comingSoon) {
          void openConnectInterest(svc);
          return;
        }

        if (!selectedSlotId) {
          promptPickSlotFirst();
          return;
        }

        if (svc) pickServiceForSlot(svc);
      }

      function showBookingBar() {
        if (!reservedSlot || !activeOffering || !bookingBar || !bookingMsg || !bookingPay) return;
        bookingBar.hidden = false;
        if (bookingNote) bookingNote.hidden = false;

        const when = `${timeFmt.format(new Date(reservedSlot.starts_at))} on ${dateFmt.format(new Date(reservedSlot.starts_at))} (IST)`;
        const paise = connectSessionPricePaise(activeOffering);

        if (!paise) {
          bookingPay.hidden = true;
          bookingMsg.textContent = 'Payment is unavailable for this service. Pick another service or contact support.';
          syncServicePickHighlight();
          return;
        }

        bookingPay.hidden = false;
        bookingPay.textContent = `Pay ₹${(paise / 100).toFixed(0)} to confirm →`;
        bookingMsg.innerHTML = `Selected <strong>${activeOffering.title}</strong> at ${when}. Complete payment to confirm your booking.`;

        syncServicePickHighlight();
      }

      async function loadAllSlots() {
        const previousPaid = myBookings.filter((b) => b.status === 'paid');
        const [open, mine] = await Promise.all([loadConnectSlots(), loadMyConnectBookings()]);
        allSlots = open;
        const serverIds = new Set(mine.map((b) => b.id));
        const keepLocal = previousPaid.filter((b) => !serverIds.has(b.id));
        myBookings = [...mine, ...keepLocal].sort((a, b) => a.starts_at.localeCompare(b.starts_at));
        renderAvailabilityFeed();
        updateDeckState();
      }

      async function openConnectPayment() {
        if (!requireConnectAuth()) return;
        if (!reservedSlot || !activeOffering || !bookingPay) return;

        const paise = connectSessionPricePaise(activeOffering);
        if (!paise) return;

        const payLabel = `Pay ₹${(paise / 100).toFixed(0)} to confirm →`;
        bookingPay.disabled = true;
        bookingPay.textContent = 'Reserving slot…';

        const { error: holdError } = await supabase.rpc('hold_connect_slot', {
          p_service_id: activeOffering.id,
          p_slot_id: reservedSlot.id,
        });

        if (holdError) {
          bookingPay.disabled = false;
          bookingPay.textContent = payLabel;
          alert(holdError.message || 'This slot was just taken. Pick another time.');
          await clearTimeSelection();
          return;
        }

        activeHoldSlotId = reservedSlot.id;

        bookingPay.disabled = false;
        bookingPay.textContent = payLabel;

        const slotId = reservedSlot.id;
        const slotLabel = `${dateFmt.format(new Date(reservedSlot.starts_at))} ${timeFmt.format(new Date(reservedSlot.starts_at))}`;
        const options = {
          key: import.meta.env.PUBLIC_RAZORPAY_KEY_ID,
          amount: paise,
          currency: 'INR',
          name: 'algofrog.in',
          description: `${activeOffering.title} session — ${slotLabel}`,
          notes: connectPaymentNotes(authSession.user.id, slotId, activeOffering!.id, paise),
          prefill: {
            email: authSession.user.email,
            name: authSession.user.user_metadata?.full_name || '',
          },
          theme: { color: '#0f766e' },
          modal: {
            ondismiss: () => {
              void (async () => {
                await releaseActiveHold();
                await loadAllSlots();
              })();
            },
          },
          handler: async (response: { razorpay_payment_id: string }) => {
            const paymentId = response.razorpay_payment_id;
            const userId = authSession!.user.id;
            const ok = await waitForConnectPaid(slotId, paymentId, userId);
            if (!ok) {
              alert(
                'Payment received — confirmation may take a minute. Refresh Connect or contact support with payment ID: ' +
                  paymentId,
              );
              return;
            }
            activeHoldSlotId = null;
            if (reservedSlot && activeOffering) {
              myBookings = [
                {
                  id: slotId,
                  service_id: activeOffering.id,
                  starts_at: reservedSlot.starts_at,
                  ends_at: reservedSlot.ends_at,
                  status: 'paid',
                },
                ...myBookings.filter((b) => b.id !== slotId),
              ];
              renderAvailabilityFeed();
            }
            alert('Session confirmed! You will receive meeting details by email.');
            await clearTimeSelection();
          },
        };
        const rzp = new (window as Window & { Razorpay?: new (o: typeof options) => { open: () => void } }).Razorpay!(options);
        rzp.open();
      }

      bookingPay?.addEventListener('click', () => {
        void openConnectPayment();
      });

      function resetDetailModes() {
        if (detailSoonBadge) detailSoonBadge.hidden = true;
        if (detailInterest) detailInterest.hidden = true;
        if (detailBook) detailBook.hidden = true;
        if (detailPriceWrap) detailPriceWrap.hidden = false;
        if (detailFootnote) detailFootnote.hidden = false;
        if (detailInterestStatus) {
          detailInterestStatus.hidden = true;
          detailInterestStatus.textContent = '';
          detailInterestStatus.classList.remove('connect-detail-interest-status--done');
        }
        if (detailInterestNote) detailInterestNote.value = '';
        if (detailInterestBtn) {
          detailInterestBtn.disabled = false;
          detailInterestBtn.textContent = connectBatchCopy.cta;
        }
        interestServiceId = null;
      }

      function showInterestRegistered() {
        if (!detailInterestStatus || !detailInterestBtn) return;
        detailInterestStatus.hidden = false;
        detailInterestStatus.classList.add('connect-detail-interest-status--done');
        detailInterestStatus.textContent = connectBatchCopy.success;
        detailInterestBtn.textContent = 'Update note →';
      }

      async function openConnectInterest(item: ConnectService) {
        if (!detailRoot) return;
        resetDetailModes();
        interestServiceId = item.id;

        detailRoot.style.setProperty('--detail-accent', item.accent);
        const iconEl = document.getElementById('connect-detail-icon');
        const benefitEl = document.getElementById('connect-detail-benefit');
        const titleEl = document.getElementById('connect-detail-title');
        const hookEl = document.getElementById('connect-detail-hook');
        const priceAmtEl = document.getElementById('connect-detail-price-amt');
        const pricePeriodEl = document.getElementById('connect-detail-price-period');

        if (iconEl) iconEl.textContent = item.icon;
        if (benefitEl) benefitEl.textContent = item.benefit;
        if (titleEl) titleEl.textContent = item.title;
        if (hookEl) hookEl.textContent = item.hook;
        if (priceAmtEl) priceAmtEl.textContent = item.price;
        if (pricePeriodEl) {
          pricePeriodEl.textContent = `${item.pricePeriod ?? ''} · ${connectBatchCopy.priceSuffix}`.trim();
        }
        if (detailSoonBadge) detailSoonBadge.hidden = false;
        if (detailInterest) detailInterest.hidden = false;
        if (detailBook) detailBook.hidden = true;

        if (authSession) {
          const { data: onList, error } = await supabase.rpc('has_connect_interest', {
            p_service_id: item.id,
          });
          if (!error && onList) showInterestRegistered();
        } else if (detailInterestBtn) {
          detailInterestBtn.textContent = connectBatchCopy.signInCta;
        }

        detailRoot.hidden = false;
        detailRoot.setAttribute('aria-hidden', 'false');
        detailRoot.classList.add('active');
        document.body.style.overflow = 'hidden';
        detailClose?.focus();
      }

      async function submitConnectInterest() {
        if (!interestServiceId || !detailInterestBtn) return;
        if (!requireConnectAuth()) return;

        detailInterestBtn.disabled = true;
        detailInterestBtn.textContent = 'Saving…';

        const { error } = await supabase.rpc('register_connect_interest', {
          p_note: detailInterestNote?.value ?? '',
          p_service_id: interestServiceId,
        });

        if (error) {
          alert(error.message || 'Could not save. Try again.');
          detailInterestBtn.disabled = false;
          detailInterestBtn.textContent = connectBatchCopy.cta;
          return;
        }

        closeConnectDetail();
        activeHoldSlotId = null;
        if (selectedSlotId) {
          selectedSlotId = null;
          selectedDateKey = null;
          resetBookingBar();
          updateDeckState();
        }
        await loadAllSlots();
      }

      function openConnectDetail(id: string) {
        const item = offerings.find((o) => o.id === id);
        if (!item || !detailRoot) return;

        resetDetailModes();
        detailRoot.style.setProperty('--detail-accent', item.accent);
        const iconEl = document.getElementById('connect-detail-icon');
        const benefitEl = document.getElementById('connect-detail-benefit');
        const titleEl = document.getElementById('connect-detail-title');
        const hookEl = document.getElementById('connect-detail-hook');
        const priceAmtEl = document.getElementById('connect-detail-price-amt');
        const pricePeriodEl = document.getElementById('connect-detail-price-period');

        if (iconEl) iconEl.textContent = item.icon;
        if (benefitEl) benefitEl.textContent = item.benefit;
        if (titleEl) titleEl.textContent = item.title;
        if (hookEl) hookEl.textContent = item.hook;
        if (priceAmtEl) priceAmtEl.textContent = item.price;
        if (pricePeriodEl) pricePeriodEl.textContent = item.pricePeriod ?? '';
        if (detailBook) {
          if (id === 'urgent') {
            detailBook.hidden = false;
            detailBook.href = mailtoLink(item.subject, item.mailBody);
            detailBook.textContent = 'Book via email →';
          } else {
            detailBook.hidden = true;
          }
        }

        detailRoot.hidden = false;
        detailRoot.setAttribute('aria-hidden', 'false');
        detailRoot.classList.add('active');
        document.body.style.overflow = 'hidden';
        detailClose?.focus();
      }

      function closeConnectDetail() {
        if (!detailRoot) return;
        detailRoot.classList.remove('active');
        detailRoot.setAttribute('aria-hidden', 'true');
        detailRoot.hidden = true;
        document.body.style.overflow = '';
        resetDetailModes();
      }

      detailInterestBtn?.addEventListener('click', () => {
        void submitConnectInterest();
      });

      document.querySelectorAll('[data-connect-id]').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.getAttribute('data-connect-id');
          if (id) handleDeckClick(id, el as HTMLElement);
        });
      });

      detailBackdrop?.addEventListener('click', closeConnectDetail);
      detailClose?.addEventListener('click', closeConnectDetail);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && detailRoot && !detailRoot.hidden) closeConnectDetail();
      });

      function applyConnectAuthNav(signedIn: boolean) {
        syncConnectAuthUi();
        const navAuth = document.getElementById('connect-nav-auth');
        const footerAuth = document.getElementById('connect-footer-auth');

        if (signedIn) {
          if (navAuth) {
            navAuth.textContent = 'Sign out';
            navAuth.href = '#';
            navAuth.setAttribute('aria-label', 'Sign out of your account');
            if (!navAuth.dataset.bound) {
              navAuth.dataset.bound = '1';
              navAuth.addEventListener('click', async (e) => {
                e.preventDefault();
                await supabase.auth.signOut();
                window.location.href = '/login?redirect=/connect';
              });
            }
          }
          if (footerAuth) footerAuth.hidden = true;
        } else {
          if (navAuth) {
            navAuth.textContent = 'Sign in';
            navAuth.href = '/login?redirect=/connect';
            navAuth.setAttribute('aria-label', 'Sign in');
          }
          if (footerAuth) footerAuth.hidden = false;
        }
      }

      const { data: { session } } = await supabase.auth.getSession();
      authSession = session;
      applyConnectAuthNav(!!session);

      if (session) {
        setAdminNavLink(availLink, await fetchIsAdmin());
      } else {
        setAdminNavLink(availLink, false);
      }

      await loadAllSlots();

      supabase.auth.onAuthStateChange(async (_event, nextSession) => {
        authSession = nextSession;
        applyConnectAuthNav(!!nextSession);
        if (nextSession) {
          setAdminNavLink(availLink, await fetchIsAdmin());
        } else {
          setAdminNavLink(availLink, false);
        }
        await loadAllSlots();
      });

      const themeBtn = document.getElementById('connect-theme');
      themeBtn?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* ignore */
        }
      });
    </script>
  </body>
</html>
