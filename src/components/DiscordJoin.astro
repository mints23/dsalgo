---
import {
  DISCORD_INVITE_URL,
  DISCORD_JOIN_COPY,
  DISCORD_JOIN_HEADLINE,
  DISCORD_TOPBAR_HINT,
  hasDiscordInvite,
} from '../data/community';

interface Props {
  variant?: 'link' | 'card' | 'pill' | 'topbar';
  class?: string;
}

const { variant = 'link', class: className = '' } = Astro.props;

if (!hasDiscordInvite()) return null;
---

{
  variant === 'card' ? (
    <aside class:list={['discord-join', 'discord-join--card', className]} aria-label="Discord community">
      <span class="discord-join-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
        </svg>
      </span>
      <div class="discord-join-copy">
        <p class="discord-join-title">{DISCORD_JOIN_HEADLINE}</p>
        <p class="discord-join-text">{DISCORD_JOIN_COPY}</p>
      </div>
      <a
        class="discord-join-btn"
        href={DISCORD_INVITE_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        Join Discord
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  ) : variant === 'pill' ? (
    <a
      class:list={['discord-join', 'discord-join--pill', className]}
      href={DISCORD_INVITE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
      </svg>
      Join Discord
    </a>
  ) : variant === 'topbar' ? (
    <span class:list={['topbar-discord-slot', className]}>
      <a
        class="discord-join discord-join--topbar"
        href={DISCORD_INVITE_URL}
        target="_blank"
        rel="noopener noreferrer"
        title={`Join Discord — ${DISCORD_TOPBAR_HINT}`}
        aria-label={`Join Discord — ${DISCORD_TOPBAR_HINT}`}
      >
        <span class="discord-join-topbar-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" />
          </svg>
        </span>
        <span class="discord-join-topbar-copy">
          <span class="discord-join-topbar-label">Join Discord</span>
          <span class="discord-join-topbar-hint">{DISCORD_TOPBAR_HINT}</span>
        </span>
      </a>
    </span>
  ) : (
    <a
      class:list={['discord-join', 'discord-join--link', className]}
      href={DISCORD_INVITE_URL}
      target="_blank"
      rel="noopener noreferrer"
    >
      Join our Discord community
    </a>
  )
}

<style>
  .discord-join--link {
    color: var(--primary);
    text-decoration: none;
    font-weight: 600;
  }
  .discord-join--link:hover {
    text-decoration: underline;
    color: var(--primary-h);
  }

  .discord-join--pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.75rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--hairline);
    box-shadow: none;
  }
  .discord-join--pill:hover {
    background: color-mix(in oklab, var(--primary) 5%, var(--surface));
    border-color: color-mix(in oklab, var(--primary) 22%, var(--hairline));
  }

  .discord-join--card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem 1rem;
    align-items: center;
    padding: 0.95rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--hairline);
    background: var(--surface);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--hairline) 85%, transparent);
  }
  .discord-join-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 8px;
    color: var(--primary);
    background: color-mix(in oklab, var(--primary) 9%, var(--surface));
  }
  .discord-join-copy {
    min-width: 0;
  }
  .discord-join-title {
    margin: 0 0 0.2rem;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .discord-join-text {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
  }
  .discord-join-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--inv);
    text-decoration: none;
    background: var(--primary);
    border: 1px solid color-mix(in oklab, var(--primary) 85%, #000);
    white-space: nowrap;
  }
  .discord-join-btn:hover {
    background: var(--primary-h);
    border-color: var(--primary-h);
  }

  @media (max-width: 640px) {
    .discord-join--card {
      grid-template-columns: auto 1fr;
    }
    .discord-join-btn {
      grid-column: 1 / -1;
      justify-content: center;
    }
  }
</style>
